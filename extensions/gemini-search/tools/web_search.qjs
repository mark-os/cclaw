// web_search — ask Gemini a question with Google Search grounding on, and
// return its answer plus the sources it actually used.
//
// Grounding quota on the free tier is granted per-model and is much tighter
// than plain generation quota: as of 2026-08 only gemini-2.5-flash serves
// grounded requests, while newer flash models accept ungrounded calls and 429
// the moment google_search is attached. So `models` is a preference list and a
// 429 falls through to the next entry rather than failing the call. When the
// free tier widens, put the better model first in config and nothing else
// changes.

var query = (args.query || "").trim();
if (!query) return "error: query is required";

var base = (getConfig("base_url") || "https://generativelanguage.googleapis.com").replace(/\/+$/, "");
var models = (getConfig("models") || "gemini-2.5-flash")
    .split(",").map(function (m) { return m.trim(); }).filter(Boolean);

// getConfig() never hands back a secret value; the placeholder is resolved at
// the fetch boundary, inside the child, per-secret host-bound to this API.
var apiKey = "{{SECRET:GEMINI_API_KEY}}";

var full = args.detail === "full";
var instruction = full
    ? "Answer thoroughly, but in prose — no headings or bullet lists."
    : "Answer in at most three sentences. Lead with the answer itself.";

var body = {
    contents: [{ parts: [{ text: query + "\n\n" + instruction }] }],
    tools: [{ google_search: {} }]
};

function attempt(model) {
    var r = http_request(base + "/v1beta/models/" + model + ":generateContent", {
        method: "POST",
        headers: { "x-goog-api-key": apiKey, "content-type": "application/json" },
        body: JSON.stringify(body),
        // Measured at 48s from the Pogoplug: a grounded call runs a search and
        // then has a model read the results, which is simply slower than the
        // 30s default allows. Well under the 180s ceiling.
        timeout: 90
    });
    // http_request has a fixed 30s ceiling, and a grounded call from a slow
    // link genuinely takes longer than that sometimes — the search runs, then
    // a model reads the results. Treat a timeout as worth another go rather
    // than as a dead end.
    if (r.error) return { retry: /timed out|timeout/i.test(r.error), err: "network error: " + r.error };
    if (r.status === 429) return { retry: true, err: model + ": grounding quota exhausted" };
    if (r.status !== 200) {
        var msg = r.body.slice(0, 300);
        try { msg = JSON.parse(r.body).error.message; } catch (e) {}
        // 4xx other than 429 is a bad key or a bad model name — the next model
        // in the list would fail the same way, so stop here.
        return { retry: r.status >= 500, err: model + ": HTTP " + r.status + " — " + msg };
    }
    try { return { doc: JSON.parse(r.body) }; }
    catch (e) { return { retry: true, err: model + ": unparseable response" }; }
}

// Each model gets one retry, so a single slow call does not cost the whole
// preference list. A 429 is not slow, it is a quota answer — it moves on.
var doc = null, tried = [];
outer:
for (var i = 0; i < models.length; i++) {
    for (var a = 0; a < 2; a++) {
        var out = attempt(models[i]);
        if (out.doc) { doc = out.doc; break outer; }
        tried.push(out.err);
        if (!out.retry) break outer;
        if (out.err.indexOf("quota") !== -1) break;   // next model, not again
    }
}
if (!doc) return "search failed:\n  " + tried.join("\n  ");

var cand = (doc.candidates || [])[0];
if (!cand) {
    var blocked = doc.promptFeedback && doc.promptFeedback.blockReason;
    return blocked ? "search returned nothing (blocked: " + blocked + ")"
                   : "search returned no answer";
}

// A grounded reply is sometimes several text parts. Usually they are
// successive chunks of one answer, but not always: the model also returns two
// parts that each restate the whole thing, and joining those blindly prints
// the answer twice. Drop a part that opens the same way as one already kept —
// a genuine continuation does not.
var seenOpening = {}, text = (cand.content && cand.content.parts || [])
    .map(function (p) { return p.text || ""; })
    .filter(function (t) {
        var key = t.replace(/\s+/g, " ").trim().slice(0, 60).toLowerCase();
        if (!key || seenOpening[key]) return false;
        seenOpening[key] = 1;
        return true;
    })
    .join("").trim();
if (!text) return "search returned an empty answer (finishReason: " + (cand.finishReason || "?") + ")";

// Sources: dedupe by title, since a single domain often backs several chunks.
// The uri is a Google redirector, which is what the API gives us — it resolves
// in a browser and is still worth printing so a claim can be traced.
var meta = cand.groundingMetadata || {};
var seen = {}, sources = [];
(meta.groundingChunks || []).forEach(function (c) {
    var w = c.web;
    if (!w || !w.uri || seen[w.title || w.uri]) return;
    seen[w.title || w.uri] = 1;
    sources.push("  - " + (w.title || "source") + ": " + w.uri);
});

var result = text;
if (sources.length) result += "\n\nsources:\n" + sources.slice(0, 8).join("\n");
if (!meta.groundingChunks || !meta.groundingChunks.length)
    result += "\n\n(no search results were used — this is the model's own recall, treat it as unverified)";
return result;
