# CClaw daemon configuration
# Copy to /etc/cclaw/env (or set EnvironmentFile= in cclaw.service)

# Required: API key for LLM provider
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Number of LLM worker threads (default: 2)
# CCLAW_LLM_THREADS=2

# Optional: Database path (default: ~/.cclaw/cclaw.db)
# CCLAW_DB_PATH=/var/lib/cclaw/cclaw.db

# Optional: Workspace directory (default: ~/.cclaw/agents/default/workspace)
# CCLAW_WORKSPACE=/var/lib/cclaw/workspace

# Optional: Log level (error, warn, info, debug, trace)
# CCLAW_LOG_LEVEL=info
