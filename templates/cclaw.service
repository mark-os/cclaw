[Unit]
Description=CClaw autonomous AI agent daemon
After=network.target

[Service]
Type=simple
User=cclaw
Group=cclaw
ExecStart=/usr/local/bin/cclaw --daemon
EnvironmentFile=/etc/cclaw/env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
