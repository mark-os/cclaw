// Discord Gateway channel for channel_runner.
// C owns the WebSocket transport (channel.conn.*); this handler owns the
// Discord Gateway protocol: IDENTIFY / RESUME, heartbeats + zombie detection,
// dispatch, and reconnect-with-backoff. C never learns a channel is "Discord".
//
// Inbound: gateway MESSAGE_CREATE -> channel.emit. Outbound replies go over
// REST (channel.send -> POST /channels/<id>/messages) — no new C send path.
// Admin config (keys, models, grants) lives on the web dashboard (/admin);
// chat keeps only conversation, /approvals and /admin.

// ── Gateway opcodes (Discord v10) ────────────────────────────────
var OP_DISPATCH = 0, OP_HEARTBEAT = 1, OP_IDENTIFY = 2, OP_RESUME = 6,
    OP_RECONNECT = 7, OP_INVALID_SESSION = 9, OP_HELLO = 10, OP_HEARTBEAT_ACK = 11;

var DISCORD_MAX_MSG_LEN = 2000;   // Discord's per-message content limit

// Close status we send when we intend to come back on the same gateway
// session. Discord invalidates the session on a 1000 (normal closure) and
// keeps it resumable on anything else, so every reconnect-and-RESUME path
// closes with this rather than relying on the transport's default.
var CLOSE_RESUME = 4000;

// Gateway intents (bitfield). Default covers guild + DM text with content.
var INTENT_GUILDS = 1, INTENT_GUILD_MESSAGES = 512,
    INTENT_DIRECT_MESSAGES = 4096, INTENT_MESSAGE_CONTENT = 32768;
var DEFAULT_INTENTS = INTENT_GUILDS | INTENT_GUILD_MESSAGES |
                      INTENT_DIRECT_MESSAGES | INTENT_MESSAGE_CONTENT;  // 37377

var config = {};
var cid = 0;                       // current gateway conn id (0 = none)
var hb = { interval: 0, next: 0, awaitingAck: false };
var seq = null;                    // last dispatch sequence (for heartbeat/RESUME)
var sessionId = null;              // Discord session id (RESUME); in-process only
var resumeUrl = null;              // resume_gateway_url from READY
var botId = null;                  // our own user id — drives mention/self checks
var reconnectAt = 0;               // wall-clock ms to attempt reconnect (0 = none)
var backoff = 1000;                // reconnect backoff (ms), grows to a cap
var stopped = false;               // fatal close: stop reconnecting
var connFails = 0;                 // consecutive attempts that never reached a live session
var helloBy = 0;                   // deadline for HELLO after the socket opens (0 = none)

// Display-name cache: what to call the room we are in. Guild + channel names
// arrive on GUILD_CREATE (and change under CHANNEL_UPDATE); DMs have no name,
// so they are titled after the author. Purely cosmetic — every send still
// addresses a channel id.
var chanNames = {};                // channel id -> channel name
var chanGuild = {};                // channel id -> guild id
var guildNames = {};               // guild id   -> guild name

// Seen-user directory: unique username -> id, persisted so outbound @mentions
// survive a restart. Usernames are Discord-unique (display names are not), so
// the model addresses people by handle and we substitute the snowflake at the
// boundary — an unknown handle just stays styled text (no ping, fails safe).
var users = {};                    // username (lowercase) -> user id

// Custom-emoji directory, same idea: learned from traffic, persisted. The
// model reads/writes :name:; the boundary swaps Discord's <a?:name:id> form.
var emojis = {};                   // name (lowercase) -> { n: name, id, a: animated }

var HELLO_TIMEOUT_MS = 20000;      // handshake done but gateway silent -> drop + retry
var RESUME_GIVEUP = 3;             // failed attempts before abandoning resume_gateway_url

// Admin slash-style commands (leading "/", admin-gated). Discord's native
// slash commands need REST registration + interaction handling; text commands
// are the minimal v1 (mirrors telegram).
var COMMANDS = {
    approvals: { run: function(chatId) { sendApprovals(chatId); } },
    admin:     { run: function(chatId) { sendDashboard(chatId); } }
};

function onInit() {
    config.token = channel.getConfig("bot_token");
    config.base = channel.getConfig("base_url") || "https://discord.com";
    config.gateway = channel.getConfig("gateway_url") ||
        "wss://gateway.discord.gg/?v=10&encoding=json";
    var it = channel.getConfig("intents");
    config.intents = it ? (parseInt(it, 10) || DEFAULT_INTENTS) : DEFAULT_INTENTS;
    config.requireMention = (channel.getConfig("require_mention") || "1") !== "0";
    config.ambient = parseList(channel.getConfig("ambient_channels"));
    config.allowBots = (channel.getConfig("allow_bots") || "0") === "1";
    config.debounceMs = parseInt(channel.getConfig("debounce_ms") || "0", 10) || 0;

    if (!config.token) {
        channel.log("ERROR: bot_token unresolved (set CCLAW_DISCORD_BOT_TOKEN or the encrypted secret)");
        throw new Error("no bot_token");
    }

    // botId is restored as an optimization (mention checks work before the
    // first READY); it is refreshed on every READY. Session/seq are NOT
    // restored across a process restart — the gateway session is gone, so a
    // cold start always IDENTIFYs fresh; only in-process reconnects RESUME.
    botId = channel.getState("disc_bot_id") || null;
    try { users = JSON.parse(channel.getState("disc_users") || "{}"); }
    catch (e) { users = {}; }
    try { emojis = JSON.parse(channel.getState("disc_emojis") || "{}"); }
    catch (e) { emojis = {}; }

    channel.log("discord channel ready (intents=" + config.intents +
                ", require_mention=" + config.requireMention + ")");
    connect(config.gateway);
    return {};   // no poll/webhook — the gateway connection drives everything
}

// ── Connection lifecycle ─────────────────────────────────────────

// conn.open is synchronous (blocking handshake). Catch failures so a gateway
// that is unreachable at startup schedules a retry instead of throwing out of
// onInit (which would fail --check / kill the runner).
function connect(url) {
    // Heartbeat state belongs to a single gateway session: it is only valid
    // after *this* connection's HELLO. Leaving the old interval live would let
    // onTimer beat on a socket that has not been hello'd yet.
    hb.interval = 0; hb.next = 0; hb.awaitingAck = false;
    try {
        cid = channel.conn.open({ url: url });
        helloBy = Date.now() + HELLO_TIMEOUT_MS;
        channel.log("gateway connecting id=" + cid + " url=" + url);
    } catch (e) {
        channel.log("conn.open failed: " + e + " — will retry");
        cid = 0;
        helloBy = 0;
        connectFailed();
    }
}

// An attempt that never reached READY/RESUMED. Discord hands out a per-session
// resume_gateway_url; if that host is refusing or gone we never get far enough
// for the gateway to tell us the session is dead, so retrying it forever wedges
// the channel. After a few failures, drop the session and use the main gateway.
function connectFailed() {
    connFails++;
    if (connFails >= RESUME_GIVEUP && resumeUrl) {
        channel.log("resume host failed " + connFails + "x — dropping session, falling back to main gateway");
        sessionId = null; resumeUrl = null; seq = null;
    }
    scheduleReconnect();
}

function scheduleReconnect() {
    if (stopped) return;
    reconnectAt = Date.now() + backoff;
    backoff = Math.min(backoff * 2, 30000);   // exponential, capped at 30s
}

function onConnOpen(id) {
    // WebSocket up; wait for HELLO before IDENTIFY/RESUME.
    channel.log("gateway socket open id=" + id);
}

function onConnMessage(id, text) {
    var m;
    try { m = JSON.parse(text); } catch (e) { channel.log("bad gateway json: " + e); return; }
    if (m.s !== null && m.s !== undefined) seq = m.s;   // track sequence for RESUME/heartbeat

    switch (m.op) {
        case OP_HELLO:         onHello(id, m.d); break;
        case OP_HEARTBEAT:     sendHeartbeat(id); break;      // server asked us to beat now
        case OP_HEARTBEAT_ACK: hb.awaitingAck = false; break;
        case OP_DISPATCH:      onDispatch(m); break;
        case OP_RECONNECT:                                    // server wants a reconnect
            channel.log("gateway op7 reconnect requested");
            channel.conn.close(id, CLOSE_RESUME);             // onConnClose drives the RESUME
            break;
        case OP_INVALID_SESSION: onInvalidSession(id, m.d); break;
        default: break;
    }
}

function onHello(id, d) {
    helloBy = 0;                                       // gateway spoke — watchdog off
    hb.interval = (d && d.heartbeat_interval) || 41250;
    // First heartbeat jittered (half an interval) to avoid a thundering herd.
    hb.next = Date.now() + Math.floor(hb.interval / 2);
    hb.awaitingAck = false;
    if (sessionId && resumeUrl) resume(id); else identify(id);
}

function identify(id) {
    channel.conn.send(id, JSON.stringify({
        op: OP_IDENTIFY,
        d: {
            token: config.token,
            intents: config.intents,
            properties: { os: "linux", browser: "cclaw", device: "cclaw" }
        }
    }));
    channel.log("sent IDENTIFY");
}

function resume(id) {
    channel.conn.send(id, JSON.stringify({
        op: OP_RESUME,
        d: { token: config.token, session_id: sessionId, seq: seq }
    }));
    channel.log("sent RESUME session=" + sessionId + " seq=" + seq);
}

function onDispatch(m) {
    var t = m.t, d = m.d || {};
    if (t === "READY") {
        sessionId = d.session_id || null;
        // Dial the issued resume host (honors Discord's routing); it lives
        // under .discord.gg, covered by the egress suffix allowlist.
        resumeUrl = d.resume_gateway_url ?
            d.resume_gateway_url + "/?v=10&encoding=json" : null;
        if (d.user && d.user.id) {
            botId = "" + d.user.id;
            channel.setState("disc_bot_id", botId);
        }
        backoff = 1000; connFails = 0;   // healthy connection resets backoff
        channel.log("READY as " + (d.user ? d.user.username : "?") + " session=" + sessionId);
    } else if (t === "RESUMED") {
        backoff = 1000; connFails = 0;
        channel.log("RESUMED session=" + sessionId);
    } else if (t === "MESSAGE_CREATE") {
        onMessageCreate(d);
    } else if (t === "INTERACTION_CREATE") {
        onInteraction(d);
    } else if (t === "GUILD_CREATE") {
        if (d.id) {
            guildNames["" + d.id] = d.name || "";
            var chans = d.channels || [];
            for (var ci = 0; ci < chans.length; ci++) rememberChannel(chans[ci], d.id);
        }
    } else if (t === "CHANNEL_CREATE" || t === "CHANNEL_UPDATE") {
        rememberChannel(d, d.guild_id);
    }
    // Other dispatch events are ignored.
}

// Cache one channel's display name (text-ish channels only: type 0 guild
// text, 5 announcement, 10/11/12 threads). Anything else is not a place a
// message arrives from with a useful name.
var TEXTISH = { 0: 1, 5: 1, 10: 1, 11: 1, 12: 1 };
function rememberChannel(c, guildId) {
    if (!c || !c.id) return;
    if (c.type !== undefined && !TEXTISH[c.type]) return;
    chanNames["" + c.id] = c.name || "";
    if (guildId) chanGuild["" + c.id] = "" + guildId;
}

// Human-readable name of the chat this message is in. Guild channels read
// "#general @ My Server" (degrading to "#general", then the raw id when the
// cache has not seen it); DMs read "DM with alice".
function chatTitle(chatId, guildId, author, isDm) {
    if (isDm) return "DM with " + (author.global_name || author.username || chatId);
    var cn = chanNames[chatId];
    if (!cn) return chatId;
    var gn = guildNames["" + (guildId || chanGuild[chatId] || "")];
    return gn ? "#" + cn + " @ " + gn : "#" + cn;
}

function onInvalidSession(id, resumable) {
    channel.log("INVALID_SESSION resumable=" + resumable);
    if (!resumable) { sessionId = null; resumeUrl = null; seq = null; }   // force fresh IDENTIFY
    // Discord expects a reconnect; onConnClose drives it. Only ask to keep the
    // session when the gateway said it is still resumable.
    channel.conn.close(id, resumable ? CLOSE_RESUME : 1000);
}

function onConnClose(id, code) {
    channel.log("gateway closed id=" + id + " code=" + code);
    if (id === cid) cid = 0;
    hb.awaitingAck = false;
    helloBy = 0;

    // Fatal close codes — reconnecting just fails the same way, so stop.
    // 4004 bad token; 4010 invalid shard; 4011 sharding required; 4012 invalid
    // API version; 4013 invalid intents; 4014 disallowed intents (a privileged
    // intent like MESSAGE CONTENT not enabled in the Developer Portal).
    if (code === 4004 || (code >= 4010 && code <= 4014)) {
        stopped = true;
        channel.log("FATAL gateway close " + code + (
            code === 4014 ? " — enable the MESSAGE CONTENT privileged intent in the Discord Developer Portal" :
            code === 4004 ? " — bad bot_token" :
            code === 4010 ? " — invalid shard in IDENTIFY" :
            code === 4011 ? " — bot is in too many guilds and requires sharding (unsupported)" :
            code === 4012 ? " — gateway API version rejected" : " — check the intents value"));
        return;
    }
    // Only Discord's explicit session-invalidating codes force a fresh IDENTIFY
    // (4007 invalid seq, 4009 session timed out). Every other non-fatal close —
    // including a local close from op7/zombie — keeps the session and RESUMEs;
    // if that session is actually dead Discord replies INVALID_SESSION and we
    // re-IDENTIFY then.
    if (code === 4007 || code === 4009) { sessionId = null; resumeUrl = null; seq = null; }
    connectFailed();
}

// ── Timer tick (~1s): heartbeats, zombie detection, reconnect ─────

function onTimer() {
    var now = Date.now();

    // Ambient debounce flush first: the connection branches below return
    // early, and a pending batch must not wait on a reconnect.
    if (config.debounceMs) flushDue();

    // Reconnect when due and no live connection.
    if (!stopped && cid === 0 && reconnectAt && now >= reconnectAt) {
        reconnectAt = 0;
        connect(sessionId && resumeUrl ? resumeUrl : config.gateway);
        return;
    }

    // HELLO watchdog. The socket is up but the gateway never spoke: hb.interval
    // is still 0, so the zombie check below can never fire and the connection
    // would sit dead until the process restarts.
    if (cid !== 0 && helloBy && now >= helloBy) {
        channel.log("no HELLO within " + HELLO_TIMEOUT_MS + "ms — dropping connection");
        helloBy = 0;
        channel.conn.close(cid, CLOSE_RESUME);   // onConnClose schedules the reconnect
        return;
    }

    // Heartbeat scheduling on a live, hello'd connection.
    if (cid !== 0 && hb.interval > 0 && now >= hb.next) {
        if (hb.awaitingAck) {
            // Previous heartbeat never ACKed → zombie connection. Drop it and
            // reconnect (RESUME) rather than sit on a dead socket. Push hb.next
            // out so we don't re-close before onConnClose lands and clears cid.
            channel.log("heartbeat ACK missing — zombie connection, reconnecting");
            hb.next = now + hb.interval;
            channel.conn.close(cid, CLOSE_RESUME);   // onConnClose schedules the reconnect
            return;
        }
        sendHeartbeat(cid);
    }
}

function sendHeartbeat(id) {
    channel.conn.send(id, JSON.stringify({ op: OP_HEARTBEAT, d: seq }));
    hb.awaitingAck = true;
    hb.next = Date.now() + hb.interval;
}

// ── Inbound message → envelope ───────────────────────────────────

function onMessageCreate(d) {
    if (!d || !d.id || !d.channel_id) return;
    var author = d.author || {};

    // Never react to our own messages (self-loop); ignore other bots unless
    // explicitly allowed (loop guard — several cclaw bots may share a server).
    if (botId && ("" + author.id) === botId) return;
    if (author.bot && !config.allowBots) return;

    var chatId = "" + d.channel_id;
    var isDm = !d.guild_id;
    var text = d.content || "";

    noteUser(author);
    if (d.mentions)
        for (var mi = 0; mi < d.mentions.length; mi++) noteUser(d.mentions[mi]);

    var mentioned = false;
    if (botId && d.mentions) {
        for (var i = 0; i < d.mentions.length; i++) {
            if (("" + d.mentions[i].id) === botId) { mentioned = true; break; }
        }
    }
    var replyToMe = !!(botId && d.referenced_message && d.referenced_message.author &&
                       ("" + d.referenced_message.author.id) === botId);

    // Admin commands. Gate on the *sender* (author.id), not the channel.
    // A non-admin's recognized command is silently dropped (not forwarded).
    var cmd = parseCommand(text);
    if (cmd && COMMANDS[cmd.name]) {
        if (!channel.admin.isAdmin("" + author.id)) return;
        COMMANDS[cmd.name].run(chatId, cmd.args);
        return;
    }

    // Mention gate: in a guild channel, stay silent unless addressed — unless
    // this channel is in the ambient allowlist, where the bot sees everything
    // and the agent decides when to speak (explicit delivery mode). DMs always
    // emit. Dropping here spends no session turn (the cheap deterministic gate).
    if (!isDm && config.requireMention && !mentioned && !replyToMe && !ambientChannel(chatId))
        return;

    // Rewrite <@id>/<@!id> tokens to @username so the session can read them —
    // the model has no idea which snowflake is its own, but it knows its name.
    // After parseCommand (which strips the raw <@botId> prefix itself).
    if (d.mentions) {
        for (var j = 0; j < d.mentions.length; j++) {
            var mu = d.mentions[j];
            if (!mu || !mu.id) continue;
            // Rewrite to the unique username — the handle the model must use
            // to @mention back (display names are ambiguous, not addressable).
            var nm = mu.username || ("" + mu.id);
            text = text.replace(new RegExp("<@!?" + mu.id + ">", "g"), "@" + nm);
        }
    }

    // Custom emoji: record in the directory, strip to :name: so the model
    // reads (and can parrot) them without the snowflake noise.
    text = text.replace(/<(a?):([A-Za-z0-9_~]{2,32}):(\d+)>/g,
        function (m, a, name, id) {
            var key = name.toLowerCase();
            if (!emojis[key] || emojis[key].id !== id) {
                emojis[key] = { n: name, id: id, a: a ? 1 : 0 };
                channel.setState("disc_emojis", JSON.stringify(emojis));
            }
            return ":" + name + ":";
        });

    var env = {
        chat_id: chatId,
        text: text,
        sender_id: "" + (author.id || ""),
        sender_name: displayName(author),
        chat_type: isDm ? "dm" : "group",
        chat_title: chatTitle(chatId, d.guild_id, author, isDm),
        mentioned: mentioned,
        reply_to_me: replyToMe
    };
    deliver(env, "disc_" + d.id, isDm);
}

// ── Button interactions (message components) ─────────────────────
//
// The mirror of channel_telegram.qjs's processCallback: an approval prompt's
// buttons come back as INTERACTION_CREATE. The isAdmin gate here is
// MANDATORY — the daemon trusts structural events from registered extensions
// unconditionally (channel_intent_allowed, CHANNEL_ORIGIN_EVENT), so this
// check IS the authority boundary for button decisions.

var INTERACTION_MESSAGE_COMPONENT = 3;
var CALLBACK_UPDATE_MESSAGE = 7;          // edit the message the button lives on
var CALLBACK_DEFERRED_UPDATE = 6;         // ack silently, change nothing

function onInteraction(d) {
    if (!d || d.type !== INTERACTION_MESSAGE_COMPONENT || !d.id || !d.token) return;
    var customId = (d.data && d.data.custom_id) || "";
    var user = (d.member && d.member.user) || d.user || {};
    var fromId = "" + (user.id || "");

    // Non-admin (or unrecognized button): clear the client's spinner, do
    // nothing — same silent-drop semantics as Telegram's processCallback.
    if (!channel.admin.isAdmin(fromId) || customId.indexOf("appr:") !== 0) {
        interactionRespond(d, { type: CALLBACK_DEFERRED_UPDATE });
        return;
    }

    // "appr:<approval_id>:<yes|once|no>"
    var parts = customId.substring(5).split(":");
    var approvalId = parseInt(parts[0], 10);
    var decision = parts[1] || "no";
    var toast = decision === "yes" ? "Approved" :
                decision === "once" ? "Approved once" : "Denied";

    // Interaction ids are unique per click — free idempotency via the
    // channel_events UNIQUE(channel_name, external_id) constraint.
    channel.emit("approval_decision",
        JSON.stringify({ approval_id: approvalId, decision: decision }),
        "disc_int_" + d.id);

    // Resolve the prompt in place so stale buttons can't be clicked twice.
    // The original content rides d.message; cap the edit under the message
    // limit before appending the receipt line.
    var who = user.global_name || user.username || fromId;
    var orig = (d.message && d.message.content) || "Approval";
    var suffix = "\n\n" + toast + " by " + who;
    if (orig.length + suffix.length > DISCORD_MAX_MSG_LEN)
        orig = orig.substring(0, findSplit(orig, 0, DISCORD_MAX_MSG_LEN - suffix.length));
    interactionRespond(d, {
        type: CALLBACK_UPDATE_MESSAGE,
        data: { content: orig + suffix, components: [] }
    });
}

// POST the interaction callback. Authenticated by the interaction token in
// the URL — no Authorization header needed (and none is sent).
function interactionRespond(d, body) {
    channel.http({
        method: "POST",
        url: config.base + "/api/v10/interactions/" + d.id + "/" + d.token + "/callback",
        headers: ["Content-Type: application/json"],
        body: JSON.stringify(body)
    }).then(function (r) {
        if (r.error || r.status < 200 || r.status >= 300)
            channel.log("interaction callback failed status=" + r.status +
                        " error=" + r.error);
    });
}

// "Mark (parson_mark)" — display name for reading, unique handle for
// addressing. Collapses when they match (or there is no display name).
function displayName(u) {
    var un = u.username || "";
    var gn = u.global_name || "";
    if (gn && un && gn.toLowerCase() !== un.toLowerCase())
        return gn + " (" + un + ")";
    return gn || un;
}

function noteUser(u) {
    if (!u || !u.id || !u.username) return;
    if (botId && ("" + u.id) === botId) return;
    var key = ("" + u.username).toLowerCase();
    if (users[key] === "" + u.id) return;
    users[key] = "" + u.id;
    channel.setState("disc_users", JSON.stringify(users));
}

// Outbound: @username -> <@id> for handles we have actually seen. Unknown or
// hallucinated handles pass through as plain text — no ping, no wrong target.
function rewriteMentions(text) {
    // Leading-boundary check so "user@host.com" never turns into a ping.
    return text.replace(/(^|[^a-zA-Z0-9_.])@([a-z0-9_.]{2,32})/gi,
        function (m, pre, name) {
            var id = users[name.toLowerCase()];
            return id ? pre + "<@" + id + ">" : m;
        });
}

// Outbound: :name: -> <a?:name:id> for custom emoji we have seen. Unknown
// names stay as-is (Discord renders known unicode shortcodes like :thumbsup:
// itself; anything else reads as plain text).
function rewriteEmojis(text) {
    return text.replace(/:([A-Za-z0-9_~]{2,32}):/g, function (m, name) {
        var e = emojis[name.toLowerCase()];
        return e ? "<" + (e.a ? "a" : "") + ":" + e.n + ":" + e.id + ">" : m;
    });
}

function ambientChannel(chatId) {
    return config.ambient.indexOf("*") !== -1 || config.ambient.indexOf(chatId) !== -1;
}

// ── Ambient debounce ─────────────────────────────────────────────
//
// An ambient channel hands us every message in the room, and a burst of five
// people talking would otherwise spend five turns on what is one thought. With
// debounce_ms > 0 a burst is batched into ONE envelope.
//
// Shape of the batch: C formats a group envelope as "sender_name: text" before
// it reaches the inbox (channel.c, consume path). A batch has no single
// sender, so we do that formatting ourselves — pre-joined "Name: text" lines —
// and send sender_name:"" so C's formatter passes the text through untouched.
// (The alternative, one envelope per message, is exactly what we're avoiding;
// the envelope has no multi-message shape to use instead.) sender_id carries
// the LAST speaker: it is the one the reply is answering, and it is what the
// admin fallback in the gate keys on.
//
// Timing is a latency cap, not a pure trailing debounce: the flush fires
// debounce_ms after the FIRST buffered message, so a room that never goes
// quiet still gets answered. Leading edge: a first message into a quiet chat
// emits immediately, so a one-off question is not delayed at all.
//
// Buffers live in this process only. A crash loses at most one window of
// ambient chatter — acceptable for messages nobody addressed to us.
var buffers = {};          // chatId -> { msgs: [env], firstAt, bytes }
var lastEmitAt = {};       // chatId -> ms of the last delivery for that chat

var DEBOUNCE_MAX_MSGS = 50;      // overflow guards: flush early, never drop
var DEBOUNCE_MAX_BYTES = 8192;

function deliver(env, extId, isDm) {
    var chatId = env.chat_id;
    // DMs and mention-gated channels are never debounced: both are direct
    // address, where latency is the whole product.
    if (!config.debounceMs || isDm || !ambientChannel(chatId)) {
        emitEnv(env, extId);
        return;
    }
    var buf = buffers[chatId];
    // Addressed directly: answer now, but carry the room's context with it.
    if (env.mentioned || env.reply_to_me) {
        if (buf) { buf.msgs.push(env); flush(chatId); }
        else emitEnv(env, extId);
        return;
    }
    var now = Date.now();
    if (!buf && now - (lastEmitAt[chatId] || 0) >= config.debounceMs) {
        emitEnv(env, extId);          // leading edge — quiet chat, speak up
        return;
    }
    if (!buf) buf = buffers[chatId] = { msgs: [], firstAt: now, bytes: 0 };
    buf.msgs.push(env);
    buf.bytes += (env.text || "").length + (env.sender_name || "").length + 2;
    if (buf.msgs.length >= DEBOUNCE_MAX_MSGS || buf.bytes >= DEBOUNCE_MAX_BYTES)
        flush(chatId);
}

function flush(chatId) {
    var buf = buffers[chatId];
    delete buffers[chatId];
    if (!buf || buf.msgs.length === 0) return;
    var msgs = buf.msgs;
    if (msgs.length === 1) { emitEnv(msgs[0], "disc_b" + chatId + "_" + buf.firstAt); return; }

    var lines = [], last = msgs[msgs.length - 1];
    for (var i = 0; i < msgs.length; i++) {
        var m = msgs[i];
        lines.push((m.sender_name ? m.sender_name + ": " : "") + m.text);
    }
    emitEnv({
        chat_id: chatId,
        text: lines.join("\n"),
        sender_id: last.sender_id,
        sender_name: "",              // text already carries per-line attribution
        chat_type: "group",
        chat_title: last.chat_title,
        mentioned: last.mentioned,
        reply_to_me: last.reply_to_me
    }, "disc_b" + chatId + "_" + buf.firstAt);
}

function flushDue() {
    var now = Date.now();
    for (var chatId in buffers) {
        if (now - buffers[chatId].firstAt >= config.debounceMs) flush(chatId);
    }
}

function emitEnv(env, extId) {
    lastEmitAt[env.chat_id] = Date.now();
    channel.emit("message", JSON.stringify(env), extId);
}

// ── Outbound delivery (outbox) ───────────────────────────────────

function onOutbox(item) {
    var payload;
    try { payload = JSON.parse(item.payload); } catch (e) {
        channel.failOutbox(item.id, "payload JSON parse error");
        return;
    }
    var chatId = payload.chat_id, text = payload.text;
    if (!chatId || !text) { channel.failOutbox(item.id, "missing chat_id or text"); return; }
    text = rewriteEmojis(rewriteMentions(text));
    // Buttoned prompts (approvals): the C side emits a Telegram-shaped
    // keyboard; render it as Discord message components on the final chunk.
    var comps = payload.keyboard ? kbToComponents(payload.keyboard) : null;
    if (payload.to_user) { sendToUser(chatId, text, item.id, comps); return; }
    sendChunked(chatId, text, item.id, comps);
}

// Telegram-shaped [[{text, callback_data}]] -> Discord action rows. The
// callback_data rides custom_id verbatim ("appr:<id>:<yes|once|no>", well
// under Discord's 100-char limit); styles are keyed on the decision suffix
// so the deny button reads as destructive. Discord caps: 5 buttons per row,
// 5 rows per message — the C prompts use one short row, but clamp anyway.
function kbToComponents(keyboard) {
    var rows = [];
    for (var i = 0; i < keyboard.length && rows.length < 5; i++) {
        var btns = [];
        for (var j = 0; j < keyboard[i].length && btns.length < 5; j++) {
            var b = keyboard[i][j];
            if (!b || !b.text || !b.callback_data) continue;
            var style = /:no$/.test(b.callback_data) ? 4 :      // danger
                        /:once$/.test(b.callback_data) ? 2 : 1; // secondary/primary
            btns.push({ type: 2, style: style,
                        label: b.text.substring(0, 80), custom_id: b.callback_data });
        }
        if (btns.length) rows.push({ type: 1, components: btns });
    }
    return rows.length ? rows : null;
}

// to_user=1 means the destination is a user id (an admin_ids entry), not a
// channel id. On Discord those are different namespaces, so we must open a DM
// channel first. C says only "this is a user"; the REST dance is the handler's
// business. The user->DM mapping is stable, so cache it in-process; a restart
// just re-opens (the endpoint is idempotent, it returns the existing DM).
var dmChannels = {};

function sendToUser(userId, text, outboxId, comps) {
    var dm = dmChannels[userId];
    if (dm) { sendChunked(dm, text, outboxId, comps); return; }
    channel.http({
        method: "POST",
        url: config.base + "/api/v10/users/@me/channels",
        headers: ["Authorization: Bot " + config.token, "Content-Type: application/json"],
        body: JSON.stringify({ recipient_id: "" + userId })
    }).then(function (r) {
        var id = null;
        if (!r.error && r.status >= 200 && r.status < 300) {
            try { id = JSON.parse(r.body || "{}").id; } catch (e) { id = null; }
        }
        if (!id) {
            // Fail the row rather than retrying: an admin who has DMs closed
            // (or an id that is not a user) would otherwise wedge the outbox
            // behind a notice that can never be delivered.
            channel.log("DM open failed for user " + userId + " status=" + r.status +
                        " error=" + r.error);
            channel.failOutbox(outboxId, "DM open failed for user " + userId);
            return;
        }
        dmChannels[userId] = "" + id;
        sendChunked("" + id, text, outboxId, comps);
    });
}

// Queue all chunks; the C loop sends them in order and acks the outbox row
// when the final chunk gets a 2xx (rate-limit 429 retry lives in the loop).
// Components (buttons) ride the final chunk so they sit under the full text.
function sendChunked(chatId, text, outboxId, comps) {
    var total = text.length, pos = 0;
    while (pos < total) {
        var remaining = total - pos;
        var chunkLen = remaining <= DISCORD_MAX_MSG_LEN ?
            remaining : findSplit(text, pos, DISCORD_MAX_MSG_LEN);
        var chunk = text.substring(pos, pos + chunkLen);
        pos += chunkLen;
        var isFinal = pos >= total;
        postMessage(chatId, chunk, outboxId, isFinal, isFinal ? comps : null);
    }
}

function postMessage(chatId, content, outboxId, isFinal, comps) {
    var body = { content: content };
    if (comps) body.components = comps;
    channel.send({
        method: "POST",
        url: config.base + "/api/v10/channels/" + chatId + "/messages",
        headers: ["Authorization: Bot " + config.token, "Content-Type: application/json"],
        body: JSON.stringify(body),
        outbox_id: outboxId,
        final: isFinal ? 1 : 0
    });
}

// ── Admin command replies (fire-and-forget REST, no outbox tracking) ──

function sendDashboard(chatId) {
    var url = channel.admin.dashboardUrl();
    postSimple(chatId, url ? "Admin dashboard:\n" + url :
        "Dashboard unavailable — no token minted yet (is the daemon's web server running?).");
}

function sendApprovals(chatId) {
    var list = channel.admin.listPendingApprovals();
    if (!list || list.length === 0) { postSimple(chatId, "No pending approvals."); return; }
    // One line + one button row per approval (mirrors telegram's digest).
    // Discord allows 5 action rows per message, and many args easily exceed
    // the 2000-char content limit — flush a batch when either cap is near.
    var header = "Pending approvals — buttons below, or /approve <id> | " +
                 "/deny <id> (full controls on the dashboard — /admin):";
    var buf = header, rows = [];
    for (var i = 0; i < list.length; i++) {
        var a = list[i];
        var line = "#" + a.id + " (" + a.agent + "): " + a.tool_name + " " + a.action +
                   "\n    " + argsSummary(a.args_json);
        var next = buf ? buf + "\n" + line : line;
        if ((next.length > DISCORD_MAX_MSG_LEN || rows.length >= 5) && buf) {
            postButtons(chatId, buf, rows);
            buf = line; rows = [];
        } else buf = next;
        rows.push({ type: 1, components: [
            { type: 2, style: 1, label: "Approve #" + a.id,
              custom_id: "appr:" + a.id + ":yes" },
            { type: 2, style: 4, label: "Deny #" + a.id,
              custom_id: "appr:" + a.id + ":no" }
        ]});
    }
    if (buf) postButtons(chatId, buf, rows);
}

// Fire-and-forget buttoned message (digest replies — no outbox tracking,
// like postSimple).
function postButtons(chatId, content, rows) {
    if (content.length > DISCORD_MAX_MSG_LEN)
        content = content.substring(0, findSplit(content, 0, DISCORD_MAX_MSG_LEN));
    channel.http({
        method: "POST",
        url: config.base + "/api/v10/channels/" + chatId + "/messages",
        headers: ["Authorization: Bot " + config.token, "Content-Type: application/json"],
        body: JSON.stringify({ content: content, components: rows })
    }).then(function (r) {
        if (r.error || r.status < 200 || r.status >= 300)
            channel.log("postButtons failed status=" + r.status + " error=" + r.error +
                        " body=" + (r.body || "").substring(0, 200));
    });
}

// One-line, length-capped view of an approval's arguments, so an admin can see
// WHAT they are approving without opening the dashboard. Whitespace is
// collapsed: raw args are often multi-line shell/JSON documents.
var ARGS_SUMMARY_MAX = 200;
function argsSummary(argsJson) {
    var s = (argsJson || "{}").replace(/\s+/g, " ").trim();
    if (s === "{}" || s === "") return "(no arguments)";
    if (s.length > ARGS_SUMMARY_MAX)
        s = s.substring(0, findSplit(s, 0, ARGS_SUMMARY_MAX)) + "…";
    return s;
}

function postSimple(chatId, content) {
    // Truncate on the same hardened boundary sendChunked uses — a raw
    // substring() can split a surrogate pair and Discord 400s the request.
    if (content.length > DISCORD_MAX_MSG_LEN)
        content = content.substring(0, findSplit(content, 0, DISCORD_MAX_MSG_LEN));
    channel.http({
        method: "POST",
        url: config.base + "/api/v10/channels/" + chatId + "/messages",
        headers: ["Authorization: Bot " + config.token, "Content-Type: application/json"],
        body: JSON.stringify({ content: content })
    }).then(function (r) {
        if (r.error || r.status < 200 || r.status >= 300)
            channel.log("postSimple failed status=" + r.status + " error=" + r.error +
                        " body=" + (r.body || "").substring(0, 200));
    });
}

// ── Helpers ──────────────────────────────────────────────────────

// "/cmd arg text" -> {name, args} (lowercased name), or null. A leading bot
// mention ("<@id> /cmd", how a guild user addresses the bot) is stripped first.
function parseCommand(text) {
    var t = text;
    if (botId) t = t.replace(new RegExp("^\\s*<@!?" + botId + ">\\s*"), "");
    if (t.charAt(0) !== "/") return null;
    var sp = t.indexOf(" ");
    var name = (sp === -1 ? t.substring(1) : t.substring(1, sp)).toLowerCase();
    var args = sp === -1 ? "" : t.substring(sp + 1).trim();
    return { name: name, args: args };
}

function parseList(s) {
    var out = [];
    if (!s) return out;
    var parts = s.split(",");
    for (var i = 0; i < parts.length; i++) { var v = parts[i].trim(); if (v) out.push(v); }
    return out;
}

// Find a chunk boundary <= maxLen, preferring a newline then a space. Never
// slice through a surrogate pair (QuickJS strings are UTF-16): a lone surrogate
// becomes invalid UTF-8 and Discord 400s.
function findSplit(text, start, maxLen) {
    var end = start + maxLen;
    if (end >= text.length) return text.length - start;
    for (var i = end - 1; i > start; i--) if (text.charAt(i) === "\n") return i - start + 1;
    for (var j = end - 1; j > start; j--) if (text.charAt(j) === " ") return j - start + 1;
    var boundary = text.charCodeAt(end);
    if (boundary >= 0xDC00 && boundary <= 0xDFFF) return maxLen - 1;
    return maxLen;
}
