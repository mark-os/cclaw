// Telegram channel extension for channel_runner
// Reactive handlers: onInit, onPoll, onRequest, onOutbox.
// Outbound HTTP: channel.http(req) -> Promise for API calls and media
// downloads (await never blocks the loop — the transfer runs on the runner's
// curl loop and resumes this continuation on completion); channel.send() only
// for outbox-tracked deliveries, where C owns retry/ack.
// Admin config (keys, models, grants) lives on the web dashboard (/admin
// prints the URL); chat keeps only conversation, /approvals and the push
// approval prompts.

var TG_MAX_MSG_LEN = 4096;
var VOICE_MAX_SECONDS = 120;     // reject longer voice notes up front
var VOICE_MAX_BYTES = 1536 * 1024;
var PHOTO_MAX_BYTES = 3 * 1024 * 1024;  // matches the runner's download cap
var config = {};
var offset = 0;

// Single source of truth for admin slash commands — drives both the
// Telegram "/" menu (setMyCommands) and dispatch, so the two can't drift.
var COMMANDS = {
    approvals: {
        description: "Review pending approvals",
        handler: function(chatId) { sendApprovalsMenu(chatId); }
    },
    admin: {
        description: "Get the admin dashboard link",
        handler: function(chatId) {
            var url = channel.admin.dashboardUrl();
            sendMessage(chatId, url ? "Admin dashboard:\n" + url :
                "Dashboard unavailable — no token minted yet (is the daemon's web server running?).");
        }
    }
};

// "/cmd arg text" -> {name: "cmd", args: "arg text"} (lowercased name), or
// null if text isn't a slash command at all.
function parseCommand(text) {
    if (text.charAt(0) !== "/") return null;
    var sp = text.indexOf(" ");
    var name = (sp === -1 ? text.substring(1) : text.substring(1, sp)).toLowerCase();
    var args = sp === -1 ? "" : text.substring(sp + 1).trim();
    return {name: name, args: args};
}

function onInit() {
    config.token = channel.getConfig("bot_token");
    config.base = channel.getConfig("base_url") || "https://api.telegram.org";
    config.webhook_secret = channel.getConfig("webhook_secret") || "";

    if (!config.token) {
        channel.log("ERROR: bot_token unresolved (set CCLAW_TELEGRAM_BOT_TOKEN or the encrypted secret)");
        throw new Error("no bot_token");
    }

    // Restore offset
    var saved = channel.getState("tg_offset");
    if (saved) offset = parseInt(saved, 10) || 0;

    // webhook mode: platform POSTs to the daemon, proxied to onRequest.
    // Default: long-poll getUpdates.
    var mode = channel.getConfig("mode") || "poll";
    channel.log("telegram channel ready (mode=" + mode + ", offset=" + offset + ")");

    // Fix the stale command menu (leftover from a previous bot on this token).
    var cmdList = [];
    for (var name in COMMANDS) cmdList.push({command: name, description: COMMANDS[name].description});
    tgCast("setMyCommands", {commands: cmdList});

    // Bot identity feeds the envelope's mentioned/reply_to_me facts.
    // Fire-and-forget: until it resolves both report false — in privacy-mode
    // groups Telegram mostly delivers mentions/replies anyway, so the window
    // is tiny and the fields are advisory, not authority.
    tgCall("getMe", {}).then(function(r) {
        if (r.error || r.status < 200 || r.status >= 300) {
            channel.log("getMe failed status=" + r.status + " error=" + r.error);
            return;
        }
        var d = JSON.parse(r.body);
        if (d.ok && d.result) {
            config.bot_id = "" + d.result.id;
            config.bot_username = d.result.username || "";
        }
    });

    if (mode === "webhook") return {};
    return {poll: pollShape()};
}

function pollShape() {
    return {
        method: "GET",
        url: config.base + "/bot" + config.token + "/getUpdates?" +
             "timeout=30" + (offset > 0 ? "&offset=" + offset : "")
    };
}

// ── Long-poll completion ─────────────────────────────────────────

function onPoll(result) {
    if (result.error) {
        channel.log("poll error: " + result.error);
        return {poll: pollShape()};
    }
    processUpdates(result.body);
    return {poll: pollShape()};
}

// ── Webhook mode: proxied request from the daemon ────────────────

function onRequest(req) {
    // Verification is channel code, not daemon config: Telegram echoes the
    // secret we registered with setWebhook in this header.
    if (config.webhook_secret &&
        (req.headers["X-Telegram-Bot-Api-Secret-Token"] || "") !== config.webhook_secret)
        return {status: 401, body: "bad secret"};

    var update;
    try { update = JSON.parse(req.body); } catch (e) {
        return {status: 400, body: "bad json"};
    }
    if (update.message) processMessage(update.message, update.update_id);
    else if (update.callback_query) processCallback(update.callback_query);
    else logUnhandledUpdate(update);
    return {status: 200, body: "ok"};
}

// ── Update processing (shared by poll + webhook) ─────────────────

function processUpdates(body) {
    var data;
    try { data = JSON.parse(body); } catch(e) {
        channel.log("parse error: " + e);
        return;
    }
    if (!data.ok || !data.result) return;

    for (var i = 0; i < data.result.length; i++) {
        var update = data.result[i];

        var ok = true;
        if (update.message) ok = processMessage(update.message, update.update_id);
        else if (update.callback_query) processCallback(update.callback_query);
        else logUnhandledUpdate(update);

        if (!ok) {
            channel.log("emit failed for update " + update.update_id + ", halting batch");
            break;
        }
        if (update.update_id >= offset) offset = update.update_id + 1;
    }

    // Persist offset only for successfully processed updates
    if (offset > 0) channel.setState("tg_offset", "" + offset);
}

// ── Outbox delivery ──────────────────────────────────────────────

function onOutbox(item) {
    var payload;
    try { payload = JSON.parse(item.payload); } catch(e) {
        channel.failOutbox(item.id, "JSON parse error");
        return;
    }

    var chatId = payload.chat_id;
    var text = payload.text;
    if (!chatId || !text) {
        channel.failOutbox(item.id, "missing chat_id or text");
        return;
    }

    // item.mode is the delivery ladder position: 0=formatted (markdown →
    // Telegram HTML), 1=plain. The C loop re-delivers a formatted row at
    // plain after a terminal 4xx, so a converter bug degrades the message
    // instead of stalling the reply.
    var plain = (item.mode || 0) >= 1;

    if (payload.keyboard) {
        // Buttoned prompts (e.g. approvals) are short — never chunked.
        // They ride the same ladder: formatted first, plain on re-delivery.
        sendKeyboard(chatId, text, payload.keyboard,
                     {outbox_id: item.id, final: 1, plain: plain});
        return;
    }

    // Queue all chunks; the C loop sends them in order and acks the
    // outbox row when the final chunk gets a 2xx.
    sendChunked(chatId, text, item.id, plain);
}

// ── Message processing ──────────────────────────────────────────

// Which non-text payload a message carries, for logging + the user reply.
function messageKind(msg) {
    var keys = ["photo", "document", "voice", "audio", "video", "video_note",
                "sticker", "animation", "location", "contact", "poll", "dice",
                "venue", "game"];
    for (var i = 0; i < keys.length; i++) if (msg[keys[i]]) return keys[i];
    return "non-text";
}

// Update types we deliberately don't act on: acknowledge (offset still
// advances) and log rather than silently dropping. Edits/channel posts are
// not reprocessed — replaying them as new messages would duplicate or loop.
function logUnhandledUpdate(update) {
    var id = update.update_id;
    if (update.edited_message) channel.log("ignoring edited_message id=" + id);
    else if (update.channel_post) channel.log("ignoring channel_post id=" + id);
    else if (update.edited_channel_post) channel.log("ignoring edited_channel_post id=" + id);
    else channel.log("ignoring unsupported update id=" + id);
}

// Structured platform facts for channel.emit — the handler reports facts,
// never authority decisions (routing/gating happen in C against the DB).
// chat.id vs from.id: in a group the chat id is the (negative) group id and
// the sender id is the person; in a DM they coincide.
function envelopeFields(msg) {
    var chat = msg.chat || {};
    var from = msg.from || {};
    var text = msg.text || "";
    var mentioned = !!(config.bot_username &&
        text.indexOf("@" + config.bot_username) !== -1);
    var replyFrom = msg.reply_to_message && msg.reply_to_message.from;
    var reply_to_me = !!(config.bot_id && replyFrom &&
        ("" + replyFrom.id) === config.bot_id);
    return {
        chat_id: "" + chat.id,
        sender_id: from.id !== undefined ? "" + from.id : "",
        sender_name: from.first_name || "",
        chat_type: chat.type === "private" ? "dm" : "group",
        mentioned: mentioned,
        reply_to_me: reply_to_me
    };
}

function processMessage(msg, updateId) {
    var chat = msg.chat;
    var text = msg.text;
    if (!chat) return true;   // nothing addressable
    if (!text) {
        // Voice notes and photos are turned into text by the daemon's
        // capability-routed media preprocessing; other kinds are dropped.
        // Media fetches are async fire-and-forget: the update is acked now,
        // dedup safety is the tg_<updateId> external_id at emit time.
        if (msg.voice) { processVoice(msg, updateId); return true; }
        if (msg.photo) { processPhoto(msg, updateId); return true; }
        var kind = messageKind(msg);
        channel.log("dropping non-text message kind=" + kind + " chat=" + chat.id);
        sendMessage("" + chat.id, "I can only read text right now (got a " + kind + ").");
        return true;
    }

    var chatId = "" + chat.id;

    // Admin commands. A non-admin sending a recognized command is silently
    // dropped (not forwarded to the agent) — same as before this refactor.
    // Unrecognized "/" text (including from an admin) falls through to chat.
    // Gate on the *sender* (from.id), not the chat: in a group chat.id is the
    // group id, so an in-group admin would otherwise fail this check while
    // passing the from.id check in processCallback (inconsistent).
    var cmd = parseCommand(text);
    if (cmd && COMMANDS[cmd.name]) {
        var fromId = msg.from ? "" + msg.from.id : "";
        if (!channel.admin.isAdmin(fromId)) return true;
        COMMANDS[cmd.name].handler(chatId, cmd.args);
        return true;
    }

    // Regular message → emit to daemon
    var env = envelopeFields(msg);
    env.text = text;
    return channel.emit("message", JSON.stringify(env), "tg_" + updateId) === 0;
}

// ── Media messages (voice, photo) ───────────────────────────────
// getFile → download to the runner's media spool (save_to: the bytes stream
// to disk in C and never enter the JS heap) → emit with media {kind, mime,
// path}; the daemon routes it to a capability-matched preprocessing model
// (transcription / description) and only its text output reaches the agent.

async function processVoice(msg, updateId) {
    var chatId = "" + msg.chat.id;
    var v = msg.voice;
    if ((v.duration || 0) > VOICE_MAX_SECONDS || (v.file_size || 0) > VOICE_MAX_BYTES) {
        channel.log("rejecting oversize voice chat=" + chatId +
                    " duration=" + v.duration + " size=" + v.file_size);
        sendMessage(chatId, "That voice message is too long for me — please keep it under 2 minutes.");
        return;
    }
    await fetchMedia(msg, updateId, chatId, v.file_id,
                     {kind: "audio", mime: v.mime_type || "audio/ogg"},
                     "voice message");
}

async function processPhoto(msg, updateId) {
    var chatId = "" + msg.chat.id;
    // photo[] is ordered by size ascending; pick the largest under the cap.
    var i = msg.photo.length - 1;
    while (i > 0 && (msg.photo[i].file_size || 0) > PHOTO_MAX_BYTES) i--;
    var p = msg.photo[i];
    if ((p.file_size || 0) > PHOTO_MAX_BYTES) {
        channel.log("rejecting oversize photo chat=" + chatId + " size=" + p.file_size);
        sendMessage(chatId, "That photo is too large for me.");
        return;
    }
    await fetchMedia(msg, updateId, chatId, p.file_id,
                     {kind: "image", mime: "image/jpeg"}, "photo");
}

async function fetchMedia(msg, updateId, chatId, fileId, media, what) {
    try {
        var fr = await tgCall("getFile", {file_id: fileId});
        var filePath = null;
        if (!fr.error && fr.status >= 200 && fr.status < 300) {
            var d = JSON.parse(fr.body);
            if (d.ok && d.result) filePath = d.result.file_path;
        }
        if (!filePath) throw "getFile status=" + fr.status + " error=" + fr.error;

        var dot = filePath.lastIndexOf(".");
        var ext = dot > filePath.lastIndexOf("/") ? filePath.substring(dot) : "";
        var dl = await channel.http({
            method: "GET",
            url: config.base + "/file/bot" + config.token + "/" + filePath,
            save_to: "tg_" + updateId + ext
        });
        if (dl.error || dl.status < 200 || dl.status >= 300 || !dl.path)
            throw "download status=" + dl.status + " error=" + dl.error;

        media.path = dl.path;
        var env = envelopeFields(msg);
        env.text = msg.caption || "";
        env.media = media;
        if (channel.emit("message", JSON.stringify(env), "tg_" + updateId) !== 0)
            throw "emit failed";
    } catch (e) {
        channel.log(what + " failed update=" + updateId + ": " + e);
        sendMessage(chatId, "Sorry — I couldn't process that " + what + ".");
    }
}

function processCallback(cbq) {
    var fromId = cbq.from ? "" + cbq.from.id : "";
    if (!channel.admin.isAdmin(fromId)) return;

    var data = cbq.data || "";
    if (data.indexOf("appr:") === 0) {
        handleApprovalCallback(fromId, data, cbq);
        return;
    }

    // Anything else (including buttons from menus that no longer exist):
    // answer the callback so the client's loading spinner clears.
    if (cbq.id) {
        tgCast("answerCallbackQuery", {callback_query_id: cbq.id});
    }
}

// ── Approval callback ────────────────────────────────────────────

function handleApprovalCallback(fromId, data, cbq) {
    // "appr:<approval_id>:<yes|once|no>"
    var parts = data.substring(5).split(":");
    var approvalId = parts[0];
    var decision = parts[1];

    var toast = decision === "yes" ? "Approved" :
                decision === "once" ? "Approved once" : "Denied";
    if (cbq.id) {
        tgCast("answerCallbackQuery", {callback_query_id: cbq.id, text: toast});
    }

    // sender = the clicker, recorded in approvals.decided_via so the receipt
    // can name who decided (mirrors channel_discord.qjs onInteraction).
    var who = (cbq.from && cbq.from.first_name) || fromId;
    channel.emit("approval_decision",
        JSON.stringify({approval_id: parseInt(approvalId, 10), decision: decision,
                        sender: who}),
        "appr_" + cbq.id);

    // Resolve the prompt in place so stale buttons can't be clicked twice.
    if (cbq.message && cbq.message.chat) {
        var outcome = (cbq.message.text || "Approval") + "\n\n" + toast + " by " + who;
        tgCast("editMessageText", {
            chat_id: cbq.message.chat.id,
            message_id: cbq.message.message_id,
            text: outcome,
            reply_markup: {inline_keyboard: []}
        });
    }
}

// ── Telegram API helpers ─────────────────────────────────────────

// POST a Bot API method; resolves {status, body, error} (never rejects).
function tgCall(method, bodyObj) {
    return channel.http({
        method: "POST",
        url: config.base + "/bot" + config.token + "/" + method,
        body: JSON.stringify(bodyObj)
    });
}

// Fire-and-forget tgCall: log anything that isn't a clean 2xx so a bad
// request body doesn't vanish silently (bit us once: editMessageText with
// reply_markup:null 400'd with no trace, see handleApprovalCallback).
function tgCast(method, bodyObj) {
    tgCall(method, bodyObj).then(function(r) {
        if (r.error || r.status < 200 || r.status >= 300)
            channel.log(method + " failed status=" + r.status + " error=" + r.error +
                        " body=" + (r.body || "").substring(0, 200));
    });
}

// Outbox-tracked delivery via channel.send: the C loop acks/fails/retries
// the outbox row on completion — that lifecycle must stay in C.
function tgOutbox(method, bodyObj, outboxId, isFinal) {
    channel.send({
        method: "POST",
        url: config.base + "/bot" + config.token + "/" + method,
        body: JSON.stringify(bodyObj),
        outbox_id: outboxId,
        final: isFinal ? 1 : 0
    });
}

function sendMessage(chatId, text) {
    tgCast("sendMessage", {chat_id: parseInt(chatId, 10), text: text});
}

// Chunk on the PLAIN text (Telegram's 4096 limit counts parsed text, so HTML
// tags are free), then render each chunk to HTML independently — a self-
// contained chunk can never split a tag or entity. `plain` forces raw text
// (the C loop sets it after a "can't parse entities" 400, so a converter bug
// degrades to plain instead of stalling the reply).
function sendChunked(chatId, text, outboxId, plain) {
    var total = text.length;
    var pos = 0;
    while (pos < total) {
        var remaining = total - pos;
        var chunkLen = remaining <= TG_MAX_MSG_LEN ? remaining : findSplit(text, pos, TG_MAX_MSG_LEN);
        var chunk = text.substring(pos, pos + chunkLen);
        pos += chunkLen;
        var body = {chat_id: parseInt(chatId, 10), text: chunk};
        if (!plain) {
            body.text = markdownToTelegramHtml(chunk);
            body.parse_mode = "HTML";
        }
        tgOutbox("sendMessage", body, outboxId, pos >= total);
    }
}

// Minimal Markdown → Telegram HTML. Escapes &<> first (Markdown markers
// aren't among them), stashes code/link output so inline formatting can't
// corrupt it, then converts balanced inline markers. Unbalanced markers (e.g.
// a bold span split across chunks) pass through as literal text — safe.
function markdownToTelegramHtml(md) {
    // keep()/restore wrap stash indices in U+E000..U+E001 (private-use, so
    // they never occur in real text and aren't Markdown markers — the inline
    // regexes skip over placeholders). They render invisibly; that's expected.
    var stash = [];
    function keep(html) { return "\uE000" + (stash.push(html) - 1) + "\uE001"; }

    var s = md.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    // Fenced code ```...``` and inline code `...` — stashed verbatim.
    s = s.replace(/```[^\n]*\n?([\s\S]*?)```/g, function(_, c) { return keep("<pre>" + c + "</pre>"); });
    s = s.replace(/`([^`\n]+)`/g, function(_, c) { return keep("<code>" + c + "</code>"); });
    // GFM tables → <pre> block. Telegram HTML has no <table>; monospace keeps
    // columns aligned. A table is a pipe-bearing header row, a |---|---|
    // delimiter row, then pipe-bearing body rows. Stashed verbatim (escaping is
    // already done above; inline markers inside stay literal). Runs after code
    // is stashed so pipe lines inside a fence aren't mistaken for a table.
    function isTableDelim(line) {
        return /^[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*$/.test(line) &&
            line.indexOf("-") !== -1 && line.indexOf("|") !== -1;
    }
    var lines = s.split("\n"), out = [];
    for (var li = 0; li < lines.length; li++) {
        if (li + 1 < lines.length && lines[li].indexOf("|") !== -1 &&
            isTableDelim(lines[li + 1])) {
            var block = [lines[li], lines[li + 1]], j = li + 2;
            while (j < lines.length && lines[j].indexOf("|") !== -1) block.push(lines[j++]);
            out.push(keep("<pre>" + block.join("\n") + "</pre>"));
            li = j - 1;
        } else {
            out.push(lines[li]);
        }
    }
    s = out.join("\n");
    // Links [text](url)
    s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function(_, t, u) {
        return keep('<a href="' + u + '">' + t + '</a>');
    });
    // Bold, then italic (bold consumes ** / __ first so lone markers remain).
    s = s.replace(/\*\*([^\n]+?)\*\*/g, "<b>$1</b>").replace(/__([^\n]+?)__/g, "<b>$1</b>");
    s = s.replace(/\*([^\n*]+?)\*/g, "<i>$1</i>").replace(/_([^\n_]+?)_/g, "<i>$1</i>");
    // Headers → bold line (Telegram has no headings).
    s = s.replace(/^#{1,6}[ \t]+([^\n]+)$/gm, "<b>$1</b>");

    return s.replace(/\uE000(\d+)\uE001/g, function(_, i) { return stash[parseInt(i, 10)]; });
}

function findSplit(text, start, maxLen) {
    var end = start + maxLen;
    if (end >= text.length) return text.length - start;
    // Try double newline
    for (var i = end; i > start; i--) {
        if (text[i] === "\n" && i > start && text[i-1] === "\n") return i - start + 1;
    }
    // Try single newline
    for (var i2 = end; i2 > start; i2--) {
        if (text[i2] === "\n") return i2 - start + 1;
    }
    // Try sentence end
    for (var i3 = end; i3 > start; i3--) {
        var c = text[i3 - 1];
        if ((c === "." || c === "!" || c === "?") &&
            (i3 === text.length || text[i3] === " " || text[i3] === "\n"))
            return i3 - start;
    }
    // Hard cut. QuickJS strings are UTF-16: never slice through a surrogate
    // pair, or the lone surrogate becomes invalid UTF-8 and Telegram 400s.
    // If the boundary lands on a low surrogate (0xDC00–0xDFFF), its high half
    // would be orphaned at this chunk's tail — back up one unit so the whole
    // pair moves to the next chunk.
    var boundary = text.charCodeAt(end);
    if (boundary >= 0xDC00 && boundary <= 0xDFFF) return maxLen - 1;
    return maxLen;
}

// Buttoned message. Formatted (markdown → HTML) by default so approval
// prompts render their fenced tables; extra.plain forces raw text — set on
// ladder re-delivery, and for fire-and-forget menus that bypass the outbox
// (no ladder behind them, so they must not risk a parse-entities 400).
function sendKeyboard(chatId, text, keyboard, extra) {
    var plain = !!(extra && extra.plain);
    var body = {
        chat_id: parseInt(chatId, 10),
        text: plain ? text : markdownToTelegramHtml(text),
        reply_markup: {inline_keyboard: keyboard}
    };
    if (!plain) body.parse_mode = "HTML";
    if (extra && extra.outbox_id) tgOutbox("sendMessage", body, extra.outbox_id, extra.final);
    else tgCast("sendMessage", body);
}

function sendApprovalsMenu(chatId) {
    var list = channel.admin.listPendingApprovals();
    if (!list || list.length === 0) {
        sendMessage(chatId, "No pending approvals.");
        return;
    }
    var lines = [];
    var keyboard = [];
    for (var i = 0; i < list.length; i++) {
        var a = list[i];
        lines.push("#" + a.id + " (" + a.agent + "): " + a.tool_name + " " + a.action);
        keyboard.push([
            {text: "Approve #" + a.id, callback_data: "appr:" + a.id + ":yes"},
            {text: "Deny #" + a.id, callback_data: "appr:" + a.id + ":no"}
        ]);
    }
    sendKeyboard(chatId, lines.join("\n"), keyboard, {plain: true});
}
