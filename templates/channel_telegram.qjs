// Telegram channel extension for channel_runner
// Reactive handlers: onInit, onPoll, onRequest, onOutbox.
// All outbound HTTP goes through channel.send() — nothing here blocks.

var TG_MAX_MSG_LEN = 4096;
var TG_RICH_MAX_BYTES = 32768;   // sendRichMessage UTF-8 byte limit
var config = {};
var offset = 0;
var dialogs = {}; // chat_id -> {type, data}

// Load telegram.json locale
var locale = JSON.parse(channel.getConfig("locale") || "{}");

// Single source of truth for admin slash commands — drives both the
// Telegram "/" menu (setMyCommands) and dispatch, so the two can't drift.
var COMMANDS = {
    key: {
        description: "Set an API key",
        handler: function(chatId) {
            sendKeyboard(chatId, msg("key_select_provider"),
                locale.keyboards && locale.keyboards.key_providers || [
                    [{"text": "OpenRouter", "callback_data": "key:openrouter"}],
                    [{"text": "Gemini", "callback_data": "key:gemini"}],
                    [{"text": "Custom", "callback_data": "key:custom"}]
                ]);
        }
    },
    config: {
        description: "Configure model/endpoint",
        handler: function(chatId, args) {
            if (args === "model") sendProviderKeyboard(chatId, "cfg_model");
            else if (args === "endpoint") sendProviderKeyboard(chatId, "cfg_ep");
            else sendKeyboard(chatId, "What do you want to configure?", [
                [{text: "Provider model", callback_data: "cfgmenu:model"}],
                [{text: "Provider endpoint", callback_data: "cfgmenu:ep"}]
            ]);
        }
    },
    model: {
        description: "Show routing / switch the primary model",
        handler: function(chatId) { sendModelMenu(chatId); }
    },
    approvals: {
        description: "Review pending approvals",
        handler: function(chatId) { sendApprovalsMenu(chatId); }
    },
    grants: {
        description: "Manage capability grants",
        handler: function(chatId) { sendGrantsTopMenu(chatId); }
    }
};

// "/cmd arg text" -> {name: "cmd", args: "arg text"} (lowercased name), or
// null if text isn't a slash command at all.
function parseCommand(text) {
    if (text.charAt(0) !== "/") return null;
    var sp = text.indexOf(" ");
    var name = (sp === -1 ? text.substring(1) : text.substring(1, sp)).toLowerCase();
    var args = sp === -1 ? "" : text.substring(sp + 1).trim();
    return {name: name, args: args};
}

// Dialog state is durable: persist to channel_state (same store as tg_offset)
// on every mutation so an interrupted /key or grant flow resumes after a
// daemon restart instead of misrouting the pending reply as regular chat.
function saveDialogs() { channel.setConfig("dialogs", JSON.stringify(dialogs)); }
function setDialog(key, val) { dialogs[key] = val; saveDialogs(); }
function clearDialog(key) { delete dialogs[key]; saveDialogs(); }

function onInit() {
    config.token = channel.getConfig("bot_token");
    config.base = channel.getConfig("base_url") || "https://api.telegram.org";
    config.webhook_secret = channel.getConfig("webhook_secret") || "";

    if (!config.token) {
        channel.log("ERROR: no bot_token in channel_state");
        throw new Error("no bot_token");
    }

    // Restore offset
    var saved = channel.getConfig("tg_offset");
    if (saved) offset = parseInt(saved, 10) || 0;

    // Restore in-flight dialog state so a /key or grant flow survives a
    // restart (in-memory only, a crash mid-flow would misroute the reply as
    // regular chat). Persisted on every mutation via setDialog/clearDialog.
    try { dialogs = JSON.parse(channel.getConfig("dialogs") || "{}"); }
    catch (e) { dialogs = {}; }

    // webhook mode: platform POSTs to the daemon, proxied to onRequest.
    // Default: long-poll getUpdates.
    var mode = channel.getConfig("mode") || "poll";
    channel.log("telegram channel ready (mode=" + mode + ", offset=" + offset + ")");

    // Fix the stale command menu (leftover from a previous bot on this token).
    var cmdList = [];
    for (var name in COMMANDS) cmdList.push({command: name, description: COMMANDS[name].description});
    tgCall("setMyCommands", JSON.stringify({commands: cmdList}));

    if (mode === "webhook") return {};
    return {poll: pollShape()};
}

function pollShape() {
    return {
        method: "GET",
        url: config.base + "/bot" + config.token + "/getUpdates?" +
             "timeout=30" + (offset > 0 ? "&offset=" + offset : "")
    };
}

// ── Long-poll completion ─────────────────────────────────────────

function onPoll(result) {
    if (result.error) {
        channel.log("poll error: " + result.error);
        return {poll: pollShape()};
    }
    processUpdates(result.body);
    return {poll: pollShape()};
}

// ── Webhook mode: proxied request from the daemon ────────────────

function onRequest(req) {
    // Verification is channel code, not daemon config: Telegram echoes the
    // secret we registered with setWebhook in this header.
    if (config.webhook_secret &&
        (req.headers["X-Telegram-Bot-Api-Secret-Token"] || "") !== config.webhook_secret)
        return {status: 401, body: "bad secret"};

    var update;
    try { update = JSON.parse(req.body); } catch (e) {
        return {status: 400, body: "bad json"};
    }
    if (update.message) processMessage(update.message, update.update_id);
    else if (update.callback_query) processCallback(update.callback_query);
    else logUnhandledUpdate(update);
    return {status: 200, body: "ok"};
}

// ── Update processing (shared by poll + webhook) ─────────────────

function processUpdates(body) {
    var data;
    try { data = JSON.parse(body); } catch(e) {
        channel.log("parse error: " + e);
        return;
    }
    if (!data.ok || !data.result) return;

    for (var i = 0; i < data.result.length; i++) {
        var update = data.result[i];

        var ok = true;
        if (update.message) ok = processMessage(update.message, update.update_id);
        else if (update.callback_query) processCallback(update.callback_query);
        else logUnhandledUpdate(update);

        if (!ok) {
            channel.log("emit failed for update " + update.update_id + ", halting batch");
            break;
        }
        if (update.update_id >= offset) offset = update.update_id + 1;
    }

    // Persist offset only for successfully processed updates
    if (offset > 0) channel.setConfig("tg_offset", "" + offset);
}

// ── Outbox delivery ──────────────────────────────────────────────

function onOutbox(item) {
    var payload;
    try { payload = JSON.parse(item.payload); } catch(e) {
        channel.failOutbox(item.id, "JSON parse error");
        return;
    }

    var chatId = payload.chat_id || payload.channel_id;
    var text = payload.text;
    if (!chatId || !text) {
        channel.failOutbox(item.id, "missing chat_id or text");
        return;
    }

    if (payload.keyboard) {
        // Buttoned prompts (e.g. approvals) are short — never chunked.
        sendKeyboard(chatId, text, payload.keyboard, {outbox_id: item.id, final: 1});
        return;
    }

    // item.mode is the delivery ladder position, bumped by the C loop when
    // the platform rejects a format: 0=auto (rich), 1=html, 2=plain.
    var mode = item.mode || 0;

    // Rich path (Bot API 10.1 sendRichMessage): one request with the RAW
    // markdown — no escaping, no chunking. Over the 32KB byte limit, or once
    // the rich_disabled latch is set (server doesn't speak the method), fall
    // through to the chunked HTML renderer. A rich 400/404 comes back through
    // the C loop as mode=1.
    if (mode === 0 && channel.getConfig("rich_disabled") !== "1" &&
        utf8ByteLen(text) <= TG_RICH_MAX_BYTES) {
        tgCall("sendRichMessage", JSON.stringify({
            chat_id: parseInt(chatId, 10),
            rich_message: {markdown: text}
        }), {outbox_id: item.id, final: 1});
        return;
    }

    // Queue all chunks; the C loop sends them in order and acks the
    // outbox row when the final chunk gets a 2xx.
    sendChunked(chatId, text, item.id, mode === 2);
}

// UTF-8 byte length of a JS (UTF-16) string. QuickJS has no TextEncoder;
// astral chars are a surrogate pair (2 units) encoding 4 UTF-8 bytes.
function utf8ByteLen(s) {
    var n = 0;
    for (var i = 0; i < s.length; i++) {
        var c = s.charCodeAt(i);
        if (c < 0x80) n += 1;
        else if (c < 0x800) n += 2;
        else if (c >= 0xD800 && c <= 0xDBFF) { n += 4; i++; }
        else n += 3;
    }
    return n;
}

// ── Message processing ──────────────────────────────────────────

// Which non-text payload a message carries, for logging + the user reply.
function messageKind(msg) {
    var keys = ["photo", "document", "voice", "audio", "video", "video_note",
                "sticker", "animation", "location", "contact", "poll", "dice",
                "venue", "game"];
    for (var i = 0; i < keys.length; i++) if (msg[keys[i]]) return keys[i];
    return "non-text";
}

// Update types we deliberately don't act on: acknowledge (offset still
// advances) and log rather than silently dropping. Edits/channel posts are
// not reprocessed — replaying them as new messages would duplicate or loop.
function logUnhandledUpdate(update) {
    var id = update.update_id;
    if (update.edited_message) channel.log("ignoring edited_message id=" + id);
    else if (update.channel_post) channel.log("ignoring channel_post id=" + id);
    else if (update.edited_channel_post) channel.log("ignoring edited_channel_post id=" + id);
    else channel.log("ignoring unsupported update id=" + id);
}

function processMessage(msg, updateId) {
    var chat = msg.chat;
    var text = msg.text;
    if (!chat) return true;   // nothing addressable
    if (!text) {
        // Media (photo/voice/sticker/…): we're text-only. Tell the user and
        // log the kind instead of silently swallowing the message.
        var kind = messageKind(msg);
        channel.log("dropping non-text message kind=" + kind + " chat=" + chat.id);
        sendMessage("" + chat.id, "I can only read text right now (got a " + kind + ").");
        return true;
    }

    var chatId = "" + chat.id;

    // Check for pending dialog reply
    if (dialogs[chatId]) {
        handleDialogReply(chatId, text, msg.message_id);
        return true;
    }

    // Admin commands. A non-admin sending a recognized command is silently
    // dropped (not forwarded to the agent) — same as before this refactor.
    // Unrecognized "/" text (including from an admin) falls through to chat.
    // Gate on the *sender* (from.id), not the chat: in a group chat.id is the
    // group id, so an in-group admin would otherwise fail this check while
    // passing the from.id check in processCallback (inconsistent).
    var cmd = parseCommand(text);
    if (cmd && COMMANDS[cmd.name]) {
        var fromId = msg.from ? "" + msg.from.id : "";
        if (!channel.admin.isAdmin(fromId)) return true;
        COMMANDS[cmd.name].handler(chatId, cmd.args);
        return true;
    }

    // Regular message → emit to daemon
    var payload = JSON.stringify({
        channel_id: chatId,
        text: text,
        from: msg.from ? msg.from.first_name || "" : ""
    });
    return channel.emit("message", payload, "tg_" + updateId) === 0;
}

function processCallback(cbq) {
    var fromId = cbq.from ? "" + cbq.from.id : "";
    if (!channel.admin.isAdmin(fromId)) return;

    var data = cbq.data || "";
    if (data.indexOf("appr:") === 0) {
        handleApprovalCallback(fromId, data, cbq);
        return;
    }
    if (data.indexOf("greg:") === 0) {
        handleGrantFromHistoryCallback(fromId, data, cbq);
        return;
    }
    if (data.indexOf("gtm:") === 0) { handleGrantsTopCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpa:") === 0) { handleGrantsAgentCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpr:") === 0) { handleGrantsRevokeCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpe:") === 0) { handleGrantsEditCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpn:") === 0) { handleGrantsAddCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpb") === 0) { handleGrantsBackCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpk:") === 0) { handleGrantsKindCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpt:") === 0) { handleGrantsToolCallback(fromId, data, cbq); return; }
    if (data.indexOf("gpm:") === 0) { handleGrantsModeCallback(fromId, data, cbq); return; }

    // Answer callback to dismiss loading
    if (cbq.id) {
        tgCall("answerCallbackQuery", JSON.stringify({callback_query_id: cbq.id}));
    }

    if (data.indexOf("key:") === 0) handleKeyCallback(fromId, data);
    else if (data.indexOf("cfg_model:") === 0) handleConfigModelCallback(fromId, data);
    else if (data.indexOf("cfg_ep:") === 0) handleConfigEndpointCallback(fromId, data);
    else if (data.indexOf("cfgmenu:") === 0)
        sendProviderKeyboard(fromId, data.substring(8) === "model" ? "cfg_model" : "cfg_ep");
    else if (data.indexOf("mdl:") === 0) handleModelDetailsCallback(fromId, data);
    else if (data.indexOf("mdlgo:") === 0) handleModelSwitchCallback(fromId, data);
    else if (data.indexOf("mdlkey:") === 0) handleModelKeyCallback(fromId, data);
    else if (data === "mdlback") sendModelMenu(fromId);
}

// ── Approval callback ────────────────────────────────────────────

function handleApprovalCallback(fromId, data, cbq) {
    // "appr:<approval_id>:<yes|once|no>"
    var parts = data.substring(5).split(":");
    var approvalId = parts[0];
    var decision = parts[1];

    var toast = decision === "yes" ? "Approved" :
                decision === "once" ? "Approved once" : "Denied";
    if (cbq.id) {
        tgCall("answerCallbackQuery", JSON.stringify({callback_query_id: cbq.id, text: toast}));
    }

    channel.emit("approval_decision",
        JSON.stringify({approval_id: parseInt(approvalId, 10), decision: decision}),
        "appr_" + cbq.id);

    // Resolve the prompt in place so stale buttons can't be clicked twice.
    if (cbq.message && cbq.message.chat) {
        var who = (cbq.from && cbq.from.first_name) || fromId;
        var outcome = (cbq.message.text || "Approval") + "\n\n" + toast + " by " + who;
        tgCall("editMessageText", JSON.stringify({
            chat_id: cbq.message.chat.id,
            message_id: cbq.message.message_id,
            text: outcome,
            reply_markup: {inline_keyboard: []}
        }), {tag: "edit_" + cbq.id});
    }
}

// ── Grant-from-history callback ───────────────────────────────────

function handleGrantFromHistoryCallback(fromId, data, cbq) {
    // "greg:<approval_id>:yes" — a denied approval is terminal, so this
    // applies a fresh grant directly rather than resolving the old row.
    var parts = data.substring(5).split(":");
    var approvalId = parts[0];

    var rc = channel.admin.grantFromHistory(parseInt(approvalId, 10));
    var toast = rc === 0 ? "Granted" : "Grant failed";
    if (cbq.id) {
        tgCall("answerCallbackQuery", JSON.stringify({callback_query_id: cbq.id, text: toast}));
    }

    if (cbq.message && cbq.message.chat) {
        var who = (cbq.from && cbq.from.first_name) || fromId;
        var outcome = (cbq.message.text || "Request") + "\n\n" + toast + " by " + who;
        tgCall("editMessageText", JSON.stringify({
            chat_id: cbq.message.chat.id,
            message_id: cbq.message.message_id,
            text: outcome,
            reply_markup: {inline_keyboard: []}
        }), {tag: "edit_" + cbq.id});
    }
}

// ── Grants CRUD (/grants "Manage Grants" flow) ────────────────────
//
// One message, edited in place via editMessageText as the admin navigates:
// top menu -> agent picker -> grants list -> (add: kind -> tool|host|path
// picker, or edit: free-text prompt). Agents/tools are referenced by index
// into a freshly-fetched, name-ordered list; grants by their rowid — never
// by raw name/value — so callback_data (64-byte cap) never risks overflow.

function answerCbq(cbq, text) {
    if (cbq.id) tgCall("answerCallbackQuery", JSON.stringify({callback_query_id: cbq.id, text: text || ""}));
}

function editGrantsMessage(cbq, text, keyboard) {
    if (!cbq.message || !cbq.message.chat) return;
    tgCall("editMessageText", JSON.stringify({
        chat_id: cbq.message.chat.id,
        message_id: cbq.message.message_id,
        text: text,
        reply_markup: {inline_keyboard: keyboard || []}
    }), {tag: "edit_grants"});
}

function agentAtIndex(idx) {
    var agents = channel.admin.listAgents();
    return (agents && idx >= 0 && idx < agents.length) ? agents[idx] : null;
}

function sendGrantsTopMenu(chatId) {
    sendKeyboard(chatId, "Grants", [
        [{text: "Manage Grants", callback_data: "gtm:m"}],
        [{text: "View Denied Requests", callback_data: "gtm:h"}]
    ]);
}

function handleGrantsTopCallback(fromId, data, cbq) {
    answerCbq(cbq);
    if (data === "gtm:h") {
        // Existing, untouched denial-history view — sends its own message
        // rather than editing this one (channel-scoped, not agent-scoped).
        if (cbq.message && cbq.message.chat) sendGrantsMenu("" + cbq.message.chat.id);
        return;
    }
    renderAgentPicker(cbq);
}

function renderAgentPicker(cbq) {
    var agents = channel.admin.listAgents();
    if (!agents || agents.length === 0) {
        editGrantsMessage(cbq, "No agents found.", []);
        return;
    }
    var keyboard = [];
    for (var i = 0; i < agents.length && i < 20; i++) {
        keyboard.push([{text: agents[i], callback_data: "gpa:" + i}]);
    }
    editGrantsMessage(cbq, "Select agent:", keyboard);
}

function handleGrantsAgentCallback(fromId, data, cbq) {
    answerCbq(cbq);
    var agentIdx = parseInt(data.substring(4), 10);
    renderGrantsList(cbq, agentIdx);
}

function renderGrantsList(cbq, agentIdx) {
    var agent = agentAtIndex(agentIdx);
    if (!agent) {
        editGrantsMessage(cbq, "Agent no longer exists.", []);
        return;
    }

    var grants = channel.admin.listGrants(agent);
    var lines = [agent + " grants:"];
    var keyboard = [];
    if (!grants || grants.length === 0) lines.push("(none)");
    for (var i = 0; i < grants.length; i++) {
        var g = grants[i];
        lines.push(g.kind + ": " + g.value);
        var row = [{text: "Revoke " + g.kind, callback_data: "gpr:" + agentIdx + ":" + g.id}];
        if (g.kind === "host" || g.kind === "read_path" || g.kind === "write_path")
            row.push({text: "Edit " + g.kind, callback_data: "gpe:" + agentIdx + ":" + g.id});
        keyboard.push(row);
    }
    keyboard.push([{text: "+ Add", callback_data: "gpn:" + agentIdx}]);
    keyboard.push([{text: "Back", callback_data: "gpb"}]);
    editGrantsMessage(cbq, lines.join("\n"), keyboard);
}

function handleGrantsBackCallback(fromId, data, cbq) {
    answerCbq(cbq);
    renderAgentPicker(cbq);
}

function handleGrantsRevokeCallback(fromId, data, cbq) {
    // "gpr:<agentIdx>:<rowid>"
    var parts = data.substring(4).split(":");
    var agentIdx = parseInt(parts[0], 10);
    var rowId = parseInt(parts[1], 10);
    var rc = channel.admin.revokeGrant(rowId);
    answerCbq(cbq, rc === 0 ? "Revoked" : "Revoke failed");
    renderGrantsList(cbq, agentIdx);
}

function handleGrantsEditCallback(fromId, data, cbq) {
    answerCbq(cbq);
    // "gpe:<agentIdx>:<rowid>"
    var parts = data.substring(4).split(":");
    var agentIdx = parseInt(parts[0], 10);
    var rowId = parseInt(parts[1], 10);
    var agent = agentAtIndex(agentIdx);
    if (!agent) { editGrantsMessage(cbq, "Agent no longer exists.", []); return; }

    var grants = channel.admin.listGrants(agent);
    var target = null;
    for (var i = 0; i < grants.length; i++) {
        if (grants[i].id === rowId) { target = grants[i]; break; }
    }
    if (!target) { renderGrantsList(cbq, agentIdx); return; }

    setDialog(fromId, {
        type: "grant_value", agentIdx: agentIdx, kind: target.kind,
        editRowId: rowId,
        listMessageId: cbq.message.message_id, listChatId: cbq.message.chat.id
    });
    sendForceReply(fromId, "Editing " + target.kind + " grant (currently: " +
        target.value + ") — reply with the new value, or /cancel");
}

function handleGrantsAddCallback(fromId, data, cbq) {
    answerCbq(cbq);
    var agentIdx = parseInt(data.substring(4), 10);
    editGrantsMessage(cbq, "Add grant — select kind:", [
        [{text: "Tool", callback_data: "gpk:" + agentIdx + ":tool"}],
        [{text: "Host", callback_data: "gpk:" + agentIdx + ":host"}],
        [{text: "Path", callback_data: "gpk:" + agentIdx + ":path"}]
    ]);
}

function handleGrantsKindCallback(fromId, data, cbq) {
    answerCbq(cbq);
    // "gpk:<agentIdx>:tool|host|path"
    var parts = data.substring(4).split(":");
    var agentIdx = parseInt(parts[0], 10);
    var kind = parts[1];

    if (kind === "tool") {
        renderToolPicker(cbq, agentIdx);
    } else if (kind === "host") {
        setDialog(fromId, {
            type: "grant_value", agentIdx: agentIdx, kind: "host",
            listMessageId: cbq.message.message_id, listChatId: cbq.message.chat.id
        });
        sendForceReply(fromId, "Enter hostname to grant, or /cancel:");
    } else if (kind === "path") {
        editGrantsMessage(cbq, "Path access mode:", [
            [{text: "Read", callback_data: "gpm:" + agentIdx + ":read"}],
            [{text: "Write", callback_data: "gpm:" + agentIdx + ":write"}]
        ]);
    }
}

function renderToolPicker(cbq, agentIdx) {
    var tools = channel.admin.listTools();
    if (!tools || tools.length === 0) {
        editGrantsMessage(cbq, "No tools found.", []);
        return;
    }
    var keyboard = [];
    for (var i = 0; i < tools.length && i < 30; i++) {
        keyboard.push([{text: tools[i], callback_data: "gpt:" + agentIdx + ":" + i}]);
    }
    editGrantsMessage(cbq, "Select tool to grant:", keyboard);
}

function handleGrantsToolCallback(fromId, data, cbq) {
    // "gpt:<agentIdx>:<toolIdx>" — grants immediately, no free text.
    var parts = data.substring(4).split(":");
    var agentIdx = parseInt(parts[0], 10);
    var toolIdx = parseInt(parts[1], 10);
    var agent = agentAtIndex(agentIdx);
    var tools = channel.admin.listTools();
    var toolName = (tools && toolIdx >= 0 && toolIdx < tools.length) ? tools[toolIdx] : null;

    var rc = -1;
    if (agent && toolName) rc = channel.admin.grantCapability(agent, "tool", toolName);
    answerCbq(cbq, rc === 0 ? "Granted" : "Grant failed");
    renderGrantsList(cbq, agentIdx);
}

function handleGrantsModeCallback(fromId, data, cbq) {
    answerCbq(cbq);
    // "gpm:<agentIdx>:read|write"
    var parts = data.substring(4).split(":");
    var agentIdx = parseInt(parts[0], 10);
    var mode = parts[1];
    setDialog(fromId, {
        type: "grant_value", agentIdx: agentIdx,
        kind: mode === "write" ? "write_path" : "read_path",
        listMessageId: cbq.message.message_id, listChatId: cbq.message.chat.id
    });
    sendForceReply(fromId, "Enter path to grant " + mode + " access to, or /cancel:");
}

// ── Admin command dispatch ───────────────────────────────────────

// ── Key dialog ───────────────────────────────────────────────────

function handleKeyCallback(chatId, data) {
    var provider = data.substring(4);
    setDialog(chatId, {type: "key", provider: provider});

    var prompt = provider === "custom" ? msg("key_prompt_custom") :
        msg("key_prompt_" + provider) || ("Send the API key for " + provider + ":");
    sendForceReply(chatId, prompt);
}

// ── Model routing (/model) ───────────────────────────────────────

function modelSummaryLine(m, i) {
    var s = (i + 1) + ". " + m.id + " — " + m.status;
    if (m.degraded_left > 0) s += " (retry in " + m.degraded_left + "s)";
    s += ", key " + (m.has_key ? "✓" : "MISSING");
    s += ", ctx " + (m.context_window > 0 ? m.context_window : "default");
    return s;
}

function sendModelMenu(chatId) {
    var list = channel.admin.listModels();
    if (!list || list.length === 0) {
        sendMessage(chatId, "No models registered — the config provider is serving requests. The agent can add models via configure_provider.");
        return;
    }
    var lines = ["Routing order (first healthy model serves each request):"];
    var keyboard = [];
    for (var i = 0; i < list.length; i++) {
        lines.push(modelSummaryLine(list[i], i));
        keyboard.push([{text: (i === 0 ? "★ " : "") + list[i].id, callback_data: "mdl:" + i}]);
    }
    lines.push("");
    lines.push("Tap a model for details / to make it primary.");
    sendKeyboard(chatId, lines.join("\n"), keyboard);
}

function handleModelDetailsCallback(chatId, data) {
    var idx = parseInt(data.substring(4), 10);
    var list = channel.admin.listModels();
    var m = list[idx];
    if (!m) { sendMessage(chatId, "Model list changed — run /model again."); return; }

    var lines = [
        "Model: " + m.model,
        "Id: " + m.id,
        "Provider: " + m.provider + " (" + m.base_url + ")",
        "Context window: " + (m.context_window > 0 ? m.context_window : "default"),
        "Key (" + m.api_key_env + "): " + (m.has_key ? "present" : "MISSING"),
        "Status: " + m.status + (m.degraded_left > 0 ? " (retry in " + m.degraded_left + "s)" : ""),
        "Requests: " + m.total_requests + " (errors 5xx: " + m.err_5xx + ", 429: " + m.err_429 + ")"
    ];
    var keyboard = [];
    if (idx !== 0) {
        lines.push("");
        lines.push("Switching keeps the current primary as first fallback: on repeated errors or a bad key, requests fall back automatically and you get a notice here.");
        if (!m.has_key)
            lines.push("⚠ No key found for " + m.api_key_env + " — set it first or the switch will immediately fall back.");
        keyboard.push([{text: "Make primary", callback_data: "mdlgo:" + idx}]);
    }
    if (!m.has_key)
        keyboard.push([{text: "Set key " + m.api_key_env, callback_data: "mdlkey:" + idx}]);
    keyboard.push([{text: "« Back", callback_data: "mdlback"}]);
    sendKeyboard(chatId, lines.join("\n"), keyboard);
}

function handleModelSwitchCallback(chatId, data) {
    var idx = parseInt(data.substring(6), 10);
    var list = channel.admin.listModels();
    var m = list[idx];
    if (!m) { sendMessage(chatId, "Model list changed — run /model again."); return; }

    var prev = channel.admin.switchModel(m.id);
    if (prev === null) {
        sendMessage(chatId, "Switch failed — model " + m.id + " not found.");
        return;
    }
    var text = "Primary model is now " + m.id + ".";
    if (prev) text += "\nPrevious primary " + prev + " stays as first fallback — " +
                      "if " + m.id + " fails repeatedly you'll be notified here and " +
                      "requests fall back automatically.";
    sendMessage(chatId, text);
}

function handleModelKeyCallback(chatId, data) {
    var idx = parseInt(data.substring(7), 10);
    var list = channel.admin.listModels();
    var m = list[idx];
    if (!m || !m.api_key_env) { sendMessage(chatId, "Model list changed — run /model again."); return; }
    setDialog(chatId, {type: "key", provider: "custom", var_name: m.api_key_env});
    sendForceReply(chatId, "Send the API key value for " + m.api_key_env + " (message is deleted after saving):");
}

// ── Config model dialog ──────────────────────────────────────────

function handleConfigModelCallback(chatId, data) {
    var idx = parseInt(data.substring(10), 10);
    setDialog(chatId, {type: "config_model", index: idx});
    sendForceReply(chatId, msg("config_enter_model"));
}

// ── Config endpoint dialog ───────────────────────────────────────

function handleConfigEndpointCallback(chatId, data) {
    var idx = parseInt(data.substring(7), 10);
    setDialog(chatId, {type: "config_endpoint", index: idx});
    sendForceReply(chatId, msg("config_enter_endpoint"));
}

// ── Dialog reply handler ─────────────────────────────────────────

function handleDialogReply(chatId, text, messageId) {
    var d = dialogs[chatId];
    clearDialog(chatId);

    if (d.type === "grant_value" && text === "/cancel") {
        if (messageId) {
            tgCall("deleteMessage", JSON.stringify({chat_id: parseInt(chatId, 10), message_id: messageId}));
        }
        if (d.listChatId && d.listMessageId) {
            renderGrantsList({message: {chat: {id: d.listChatId}, message_id: d.listMessageId}}, d.agentIdx);
        }
        return;
    }

    if (d.type === "key") {
        if (messageId) deleteSensitiveMessage(chatId, messageId, 1);
        // var_name set (e.g. from /model "Set key"): user sends the bare value,
        // we prepend the env var name the custom-provider path expects.
        var keyVal = d.var_name ? d.var_name + "=" + text : text;
        var rc = channel.admin.setKey(d.provider, keyVal);
        sendMessage(chatId, rc === 0 ? msg("key_saved") : msg("key_failed"));
    } else if (d.type === "config_model") {
        var rc2 = channel.admin.setModel(d.index, text);
        sendMessage(chatId, rc2 === 0 ? msg("config_model_updated") + text : "Failed to update model.");
    } else if (d.type === "config_endpoint") {
        if (text.indexOf("http://") !== 0 && text.indexOf("https://") !== 0) {
            sendMessage(chatId, msg("config_endpoint_invalid"));
            return;
        }
        var rc3 = channel.admin.setEndpoint(d.index, text);
        sendMessage(chatId, rc3 === 0 ? msg("config_endpoint_updated") + text : "Failed to update endpoint.");
    } else if (d.type === "grant_value") {
        if (messageId) deleteSensitiveMessage(chatId, messageId, 1);
        var agent = agentAtIndex(d.agentIdx);
        var rc5 = -1;
        if (agent) {
            if (d.editRowId) channel.admin.revokeGrant(d.editRowId);
            rc5 = channel.admin.grantCapability(agent, d.kind, text);
        }
        if (d.listChatId && d.listMessageId) {
            var fakeCbq = {message: {chat: {id: d.listChatId}, message_id: d.listMessageId}};
            if (rc5 === 0) renderGrantsList(fakeCbq, d.agentIdx);
            else editGrantsMessage(fakeCbq, "Grant failed.", []);
        }
    }
}

// ── Telegram API helpers (queue shapes; the C loop executes) ─────

function tgCall(method, body, extra) {
    var req = {
        method: "POST",
        url: config.base + "/bot" + config.token + "/" + method,
        body: body
    };
    if (extra) {
        if (extra.outbox_id) req.outbox_id = extra.outbox_id;
        if (extra.final) req.final = 1;
        if (extra.tag) req.tag = extra.tag;
    }
    channel.send(req);
}

// Calls made with a tag (no outbox_id) get no other failure tracking —
// log anything that isn't a clean 2xx so a bad request body doesn't vanish
// silently (bit us once: editMessageText with reply_markup:null 400'd with
// no trace, see handleApprovalCallback).
function onResult(r) {
    var failed = r.error || r.status < 200 || r.status >= 300;

    // Tracked secret-scrub delete (see deleteSensitiveMessage). Retry once,
    // then warn the user to delete it manually.
    if (r.tag && r.tag.indexOf("del:") === 0) {
        if (!failed) return;                                       // gone, good
        // Already removed (double-delete / user beat us to it): nothing to warn.
        if ((r.body || "").indexOf("message to delete not found") !== -1) return;
        var p = r.tag.substring(4).split(":");
        var delChat = p[0], delMsg = parseInt(p[1], 10), attempt = parseInt(p[2], 10);
        if (attempt < 2) {
            deleteSensitiveMessage(delChat, delMsg, attempt + 1);
        } else {
            channel.log("deleteMessage gave up chat=" + delChat + " msg=" + delMsg +
                        " status=" + r.status + " body=" + (r.body || "").substring(0, 120));
            sendMessage(delChat, "⚠️ I couldn't delete your previous message. " +
                "It may contain a secret — please delete it manually from this chat.");
        }
        return;
    }

    if (failed) {
        channel.log("tgCall failed tag=" + r.tag + " status=" + r.status +
                    " error=" + r.error + " body=" + (r.body || "").substring(0, 200));
    }
}

function sendMessage(chatId, text) {
    tgCall("sendMessage", JSON.stringify({chat_id: parseInt(chatId, 10), text: text}));
}

// Delete a message that contains captured-secret plaintext (an API key, a
// grant value). Tracked with a "del:<chatId>:<messageId>:<attempt>" tag so
// onResult can retry once and, failing that, warn the user to remove it by
// hand — a secret left in chat history forever is the security hazard here.
function deleteSensitiveMessage(chatId, messageId, attempt) {
    tgCall("deleteMessage",
        JSON.stringify({chat_id: parseInt(chatId, 10), message_id: messageId}),
        {tag: "del:" + chatId + ":" + messageId + ":" + (attempt || 1)});
}

// Chunk on the PLAIN text (Telegram's 4096 limit counts parsed text, so HTML
// tags are free), then render each chunk to HTML independently — a self-
// contained chunk can never split a tag or entity. `plain` forces raw text
// (the C loop sets it after a "can't parse entities" 400, so a converter bug
// degrades to plain instead of stalling the reply).
function sendChunked(chatId, text, outboxId, plain) {
    var total = text.length;
    var pos = 0;
    while (pos < total) {
        var remaining = total - pos;
        var chunkLen = remaining <= TG_MAX_MSG_LEN ? remaining : findSplit(text, pos, TG_MAX_MSG_LEN);
        var chunk = text.substring(pos, pos + chunkLen);
        pos += chunkLen;
        var body = {chat_id: parseInt(chatId, 10), text: chunk};
        if (!plain) {
            body.text = markdownToTelegramHtml(chunk);
            body.parse_mode = "HTML";
        }
        tgCall("sendMessage", JSON.stringify(body),
            {outbox_id: outboxId, final: pos >= total});
    }
}

// Minimal Markdown → Telegram HTML. Escapes &<> first (Markdown markers
// aren't among them), stashes code/link output so inline formatting can't
// corrupt it, then converts balanced inline markers. Unbalanced markers (e.g.
// a bold span split across chunks) pass through as literal text — safe.
function markdownToTelegramHtml(md) {
    // keep()/restore wrap stash indices in U+E000..U+E001 (private-use, so
    // they never occur in real text and aren't Markdown markers — the inline
    // regexes skip over placeholders). They render invisibly; that's expected.
    var stash = [];
    function keep(html) { return "" + (stash.push(html) - 1) + ""; }

    var s = md.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    // Fenced code ```...``` and inline code `...` — stashed verbatim.
    s = s.replace(/```[^\n]*\n?([\s\S]*?)```/g, function(_, c) { return keep("<pre>" + c + "</pre>"); });
    s = s.replace(/`([^`\n]+)`/g, function(_, c) { return keep("<code>" + c + "</code>"); });
    // GFM tables → <pre> block. Telegram HTML has no <table>; monospace keeps
    // columns aligned. A table is a pipe-bearing header row, a |---|---|
    // delimiter row, then pipe-bearing body rows. Stashed verbatim (escaping is
    // already done above; inline markers inside stay literal). Runs after code
    // is stashed so pipe lines inside a fence aren't mistaken for a table.
    function isTableDelim(line) {
        return /^[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*$/.test(line) &&
            line.indexOf("-") !== -1 && line.indexOf("|") !== -1;
    }
    var lines = s.split("\n"), out = [];
    for (var li = 0; li < lines.length; li++) {
        if (li + 1 < lines.length && lines[li].indexOf("|") !== -1 &&
            isTableDelim(lines[li + 1])) {
            var block = [lines[li], lines[li + 1]], j = li + 2;
            while (j < lines.length && lines[j].indexOf("|") !== -1) block.push(lines[j++]);
            out.push(keep("<pre>" + block.join("\n") + "</pre>"));
            li = j - 1;
        } else {
            out.push(lines[li]);
        }
    }
    s = out.join("\n");
    // Links [text](url)
    s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function(_, t, u) {
        return keep('<a href="' + u + '">' + t + '</a>');
    });
    // Bold, then italic (bold consumes ** / __ first so lone markers remain).
    s = s.replace(/\*\*([^\n]+?)\*\*/g, "<b>$1</b>").replace(/__([^\n]+?)__/g, "<b>$1</b>");
    s = s.replace(/\*([^\n*]+?)\*/g, "<i>$1</i>").replace(/_([^\n_]+?)_/g, "<i>$1</i>");
    // Headers → bold line (Telegram has no headings).
    s = s.replace(/^#{1,6}[ \t]+([^\n]+)$/gm, "<b>$1</b>");

    return s.replace(/(\d+)/g, function(_, i) { return stash[parseInt(i, 10)]; });
}

function findSplit(text, start, maxLen) {
    var end = start + maxLen;
    if (end >= text.length) return text.length - start;
    // Try double newline
    for (var i = end; i > start; i--) {
        if (text[i] === "\n" && i > start && text[i-1] === "\n") return i - start + 1;
    }
    // Try single newline
    for (var i2 = end; i2 > start; i2--) {
        if (text[i2] === "\n") return i2 - start + 1;
    }
    // Try sentence end
    for (var i3 = end; i3 > start; i3--) {
        var c = text[i3 - 1];
        if ((c === "." || c === "!" || c === "?") &&
            (i3 === text.length || text[i3] === " " || text[i3] === "\n"))
            return i3 - start;
    }
    // Hard cut. QuickJS strings are UTF-16: never slice through a surrogate
    // pair, or the lone surrogate becomes invalid UTF-8 and Telegram 400s.
    // If the boundary lands on a low surrogate (0xDC00–0xDFFF), its high half
    // would be orphaned at this chunk's tail — back up one unit so the whole
    // pair moves to the next chunk.
    var boundary = text.charCodeAt(end);
    if (boundary >= 0xDC00 && boundary <= 0xDFFF) return maxLen - 1;
    return maxLen;
}

function sendKeyboard(chatId, text, keyboard, extra) {
    tgCall("sendMessage", JSON.stringify({
        chat_id: parseInt(chatId, 10),
        text: text,
        reply_markup: {inline_keyboard: keyboard}
    }), extra);
}

function sendForceReply(chatId, text) {
    tgCall("sendMessage", JSON.stringify({
        chat_id: parseInt(chatId, 10),
        text: text,
        reply_markup: {force_reply: true, selective: true}
    }));
}

function sendProviderKeyboard(chatId, prefix) {
    var providers = channel.admin.listProviders();
    var keyboard = [];
    for (var i = 0; i < providers.length; i++) {
        var p = providers[i];
        var label = (i === 0 ? "Primary: " : "Fallback " + i + ": ") + (p.model || "(none)");
        keyboard.push([{text: label, callback_data: prefix + ":" + i}]);
    }
    var title = prefix === "cfg_model" ? msg("config_select_provider") : msg("config_select_endpoint");
    sendKeyboard(chatId, title, keyboard);
}

function sendApprovalsMenu(chatId) {
    var list = channel.admin.listPendingApprovals();
    if (!list || list.length === 0) {
        sendMessage(chatId, "No pending approvals.");
        return;
    }
    var lines = [];
    var keyboard = [];
    for (var i = 0; i < list.length; i++) {
        var a = list[i];
        lines.push("#" + a.id + " (" + a.agent + "): " + a.tool_name + " " + a.action);
        keyboard.push([
            {text: "Approve #" + a.id, callback_data: "appr:" + a.id + ":yes"},
            {text: "Deny #" + a.id, callback_data: "appr:" + a.id + ":no"}
        ]);
    }
    sendKeyboard(chatId, lines.join("\n"), keyboard);
}

function sendGrantsMenu(chatId) {
    var list = channel.admin.listDeniedApprovals(10);
    if (!list || list.length === 0) {
        sendMessage(chatId, "No recently denied requests.");
        return;
    }
    var lines = [];
    var keyboard = [];
    for (var i = 0; i < list.length; i++) {
        var a = list[i];
        lines.push("#" + a.id + " (" + a.agent + "): " + a.tool_name + " " + a.action);
        keyboard.push([{text: "Grant #" + a.id, callback_data: "greg:" + a.id + ":yes"}]);
    }
    sendKeyboard(chatId, lines.join("\n"), keyboard);
}

// ── Helpers ──────────────────────────────────────────────────────

function msg(key) {
    return (locale.messages && locale.messages[key]) || key;
}
